function validateBooking(data) {
  const requiredFields = [
    "name",
    "email",
    "phone",
    "pickup",
    "dropoff",
    "date",
    "time",
    "passengers",
    "pickupPlaceId",
    "dropoffPlaceId",
  ];

  const email = String(data.email).trim();
  const passengers = Number(data.passengers);
  const price = Number(data.price);
  const requestedDate = new Date(`${data.date}T${data.time}`);

  const coordinates = [
    data.pickupLatitude,
    data.pickupLongitude,
    data.dropoffLatitude,
    data.dropoffLongitude,
  ];

  const latitudeValues = [
    Number(data.pickupLatitude),
    Number(data.dropoffLatitude),
  ];

  const longitudeValues = [
    Number(data.pickupLongitude),
    Number(data.dropoffLongitude),
  ];

  for (const field of requiredFields) {
    if (!data[field] || String(data[field]).trim() === "") {
      return `Missing required field: ${field}`;
    }
  }

  if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
    return "Invalid email address.";
  }
  if (!/^\d{4}-\d{2}-\d{2}$/.test(data.date)) {
    return "Invalid date.";
  }
  if (!/^\d{2}:\d{2}$/.test(data.time)) {
    return "Invalid time.";
  }
  if (!Number.isInteger(passengers) || passengers < 1 || passengers > 4) {
    return "Invalid passenger count.";
  }
  if (!Number.isFinite(price) || price < 0) {
    return "Invalid price.";
  }
  if (isNaN(requestedDate.getTime())) {
    return "Invalid date or time.";
  }
  if (data.pickupPlaceId === data.dropoffPlaceId) {
    return "Pickup and drop-off locations cannot be the same.";
  }
  if (
    latitudeValues.some((value) => value < -90 || value > 90) ||
    longitudeValues.some((value) => value < -180 || value > 180) ||
    coordinates.some((value) => !Number.isFinite(Number(value)))
  ) {
    return "Invalid location coordinates.";
  }

  return null;
}

function sendWhatsAppOwnerMessage(data, approveUrl, declineUrl) {
  const url =
    `https://graph.facebook.com/v26.0/${CONFIG.WHATSAPP_PHONE_NUMBER_ID}/messages`;

  const payload = {
    messaging_product: "whatsapp",
    to: CONFIG.WHATSAPP_OWNER_NUMBER,
    type: "template",
    template: {
      name: "luis_transfer_template",
      language: {
        code: "en"
      },
      components: [
        {
          type: "body",
          parameters: [
            { type: "text", text: data.requestId },
            { type: "text", text: data.name },
            { type: "text", text: data.phone },
            { type: "text", text: data.email },
            { type: "text", text: data.pickup },
            { type: "text", text: data.dropoff },
            { type: "text", text: data.date },
            { type: "text", text: data.time },
            { type: "text", text: String(data.passengers) },
            { type: "text", text: `${data.price}` },
            { type: "text", text: data.departTime || "-" },
            { type: "text", text: data.arriveTime || "-" },
            { type: "text", text: data.bags || "-" },
            { type: "text", text: data.notes || "-" }
          ]
        },
        {
          type: "button",
          sub_type: "url",
          index: "0",
          parameters: [
            {
              type: "text",
              text: approveUrl.replace(CONFIG.WEB_APP_URL, "")
            }
          ]
        },
        {
          type: "button",
          sub_type: "url",
          index: "1",
          parameters: [
            {
              type: "text",
              text: declineUrl.replace(CONFIG.WEB_APP_URL, "")
            }
          ]
        }
      ]
    }
  };

  const response = UrlFetchApp.fetch(url, {
    method: "post",
    contentType: "application/json",
    headers: {
      Authorization: `Bearer ${CONFIG.WHATSAPP_ACCESS_TOKEN}`
    },
    payload: JSON.stringify(payload),
    muteHttpExceptions: true
  });

  const responseCode = response.getResponseCode();
  const responseText = response.getContentText();

  const sheet = SpreadsheetApp
    .openById(CONFIG.SHEET_ID)
    .getSheetByName("Sheet1");

  sheet.getRange(sheet.getLastRow(), 25).setValue(
    `WhatsApp ${responseCode}: ${responseText}`
  );
}

function sendWhatsAppClientMessage(phone, templateName, parameters) {
  const url =
    `https://graph.facebook.com/v26.0/${CONFIG.WHATSAPP_PHONE_NUMBER_ID}/messages`;

  const payload = {
    messaging_product: "whatsapp",
    to: phone,
    type: "template",
    template: {
      name: templateName,
      language: {
        code: "en"
      },
      components: [
        {
          type: "body",
          parameters: parameters.map((value) => ({
            type: "text",
            text: String(value)
          }))
        }
      ]
    }
  };

  const response = UrlFetchApp.fetch(url, {
    method: "post",
    contentType: "application/json",
    headers: {
      Authorization: `Bearer ${CONFIG.WHATSAPP_ACCESS_TOKEN}`
    },
    payload: JSON.stringify(payload),
    muteHttpExceptions: true
  });

  const responseCode = response.getResponseCode();
  const responseText = response.getContentText();

  const sheet = SpreadsheetApp
    .openById(CONFIG.SHEET_ID)
    .getSheetByName("Sheet1");

  sheet.getRange(sheet.getLastRow(), 26).setValue(
    `TO: [${phone}] | Client WhatsApp ${templateName} ${responseCode}: ${responseText}`
  );
}

