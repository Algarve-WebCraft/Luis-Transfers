---
const { pageTitle, pageDescription } = Astro.props;
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
<link rel="icon" href="/favicon.ico" />
<meta name="generator" content={Astro.generator} />
<meta name="description" content={pageDescription} />
<meta name="theme-color" content="#0a0a0a" />
<meta property="og:title" content="Luis Ferreira | Transfers and Services" />
<meta
  property="og:description"
  content="Private transfers across the Algarve, professional property cleaning, and quality holiday accommodation. Direct, reliable service from Luis Ferreira."
/>
<meta property="og:image" content="https://luisferreira.pt/assets/logos/og-logo.webp" />
<meta property="og:url" content="https://luisferreira.pt/" />
<meta property="og:type" content="website" />
<link rel="icon" type="image/x-icon" href="/assets/logos/favicon.ico" />
<link rel="icon" type="image/png" sizes="16x16" href="/assets/logos/favicon-logo-16.png" />
<link rel="icon" type="image/png" sizes="32x32" href="/assets/logos/favicon-logo-32.png" />
<!-- prettier-ignore -->
<link rel="preload" as="font" type="font/woff2" crossorigin href="/assets/fonts/newsreader-v26-latin-regular.woff2" />
<!-- prettier-ignore -->
<link rel="preload" as="font" type="font/woff2" crossorigin href="/assets/fonts/plus-jakarta-sans-v12-latin-regular.woff2" />
<!-- prettier-ignore -->
<link rel="preload" as="font" type="font/woff2" crossorigin href="/assets/fonts/plus-jakarta-sans-v12-latin-500.woff2">
<!-- prettier-ignore -->
<link rel="preload" as="font" type="font/woff2" crossorigin href="/assets/fonts/plus-jakarta-sans-v12-latin-600.woff2">
<script is:inline>
  (() => {
    const path = location.pathname.replace(/\/+$/, "") || "/";
    const isHome = path === "/" || path === "/pt";

    if (isHome && sessionStorage.getItem("home-intro-complete") !== "true") {
      document.documentElement.classList.add("home-intro-pending");
    }
  })();
</script>
<title>{pageTitle}</title>
