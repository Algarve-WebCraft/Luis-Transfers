---
import { getLocalizedPath } from "@i18n/utils";
import { routes, Page } from "@i18n/routes";

const locale = Astro.currentLocale === "pt" ? "pt" : "en";
const currentPath = Astro.url.pathname.replace(/\/+$/, "") || "/";

const currentPage =
  (Object.keys(routes[locale]) as Page[]).find((page) => {
    const path = getLocalizedPath(locale, page);
    return (path.replace(/\/+$/, "") || "/") === currentPath;
  }) ?? "home";

const englishURL = getLocalizedPath("en", currentPage);
const portugueseURL = getLocalizedPath("pt", currentPage);

const navItems = [
  { page: "home", label: locale === "pt" ? "Início" : "Home" },
  { page: "about", label: locale === "pt" ? "Sobre" : "About" },
  { page: "menu", label: "Menu" },
  { page: "gallery", label: locale === "pt" ? "Galeria" : "Gallery" },
  { page: "contact", label: locale === "pt" ? "Contacto" : "Contact" },
] as const;
---

<header id="header" class="home-header header">
  <a href="#swup" class="skip-to-content">
    Skip to main content
  </a>

  <div class="header__container">
    <div class="wrapper wrapper--wide wrapper--header">
      <div class="business-logo-container">
        <!-- <a href="/">
          <img
            id="business-logo"
            src="/assets/logos/business-logo-white.webp"
            class="business-logo"
            width="250"
            height="67"
            fetchpriority="high"
            loading="eager"
            alt="Algarve Webcraft's logo."
          />
        </a> -->
      </div>

      <!-- <nav id="navigation" class="nav-bar">
        <ul>
          <li>
            <a href="/">Home</a>
          </li>
          <li>
            <a href="/about/">About Us</a>
          </li>
          <li>
            <a href="/menu/">Menu</a>
          </li>
          <li>
            <a href="/gallery/">Gallery</a>
          </li>
          <li>
            <a href="/contact/">Contact</a>
          </li>
        </ul>
      </nav> -->

      <nav id="navigation" class="nav-bar">
        <ul>
          {navItems.map((item) => (
            <li>
              <a href={getLocalizedPath(locale, item.page)}>{item.label}</a>
            </li>
          ))}
        </ul>
      </nav>

      <div class="language-switcher">
        <a href={englishURL} lang="en" aria-label="English" title="English">
          🇬🇧
        </a>

        <a href={portugueseURL} lang="pt-PT" aria-label="Português" title="Português">
          🇵🇹
        </a>
      </div>

      <div class="hamburger-btn-box">
