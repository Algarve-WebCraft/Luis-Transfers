</header>

<style>
  .header {
    position: relative;
    top: -0.5px;
    z-index: 1000;
    transition:
      background-color 0.35s ease,
      border-color 0.35s ease,
      box-shadow 0.35s ease;

    .header__container {
      width: 100%;
    }

    .wrapper--header {
      min-height: clamp(4.25rem, 11vw, 4.75rem);
      display: flex;
      justify-content: start;
      align-items: center;

      .cmp-main-btn {
        display: none;

        @media (width > 47.5rem) {
          display: block;
          font-size: var(--fs-13);
        }
      }
    }

    .business-logo-container {
      max-width: clamp(4rem, 9vw + 2rem, 8rem);
      margin-right: auto;

      svg {
        position: relative;
        width: 85%;
        min-width: 5.75rem;
        top: 0.5rem;
      }

      .header-sub-heading-span {
        font-size: clamp(0.5625rem, 0.65vw + 0.25rem, 0.6875rem);
        color: var(--clr-brown-10);
        text-transform: uppercase;
        white-space: nowrap;
      }
    }

    &.sticking {
      position: sticky;
      animation: slideDown 0.8s ease-out forwards;
      background-color: var(--clr-white-10);
      border-bottom: 1px solid #44474a14;
      box-shadow: var(--box-shadow-30);
    }
  }

  .language-switcher {
    position: relative;
    display: flex;
    gap: 0.5rem;
    right: 0.75rem;

    @media (width > 47.5rem) {
      right: 2rem;
    }

    a {
      transition: opacity 0.2s ease-out;

      &:hover {
        opacity: 0.55;
      }
    }
  }

  .hamburger-btn-box {
    display: flex;
    align-items: center;
    gap: 1.2rem;
    order: 1;
    margin-left: 0.75rem;
  }

  .hamburger-btn {
    width: 1.85rem;
    height: 1.5rem;
    background-color: inherit;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    cursor: pointer;
    user-select: none;
    border: none;
    z-index: 10;
    padding: 0.75rem;
    border-radius: 20%;
    background-clip: padding-box;
    box-sizing: content-box;
    touch-action: manipulation;
    transition: transform 1.2s;
    /* prettier-ignore */
    transition-timing-function: linear(0, -0.001 6.9%, -0.004 9.1%, -0.008 11%, -0.016 12.9%, -0.025 14.6%, -0.038 16.3%, -0.054 17.9%, -0.073 19.5%, -0.095 21%, -0.152 24.1%, -0.217 27%, -0.358 32.6%, -0.408 35%, -0.428 36.3%, -0.439 37.5%, -0.441 38.6%, -0.436 39.6%, -0.423 40.5%, -0.405 41.3%, -0.35 42.8%, -0.27 44.2%, -0.156 45.6%, -0.014 46.9%, 0.153 48.1%, 0.766 51.4%, 1.05 53.4%, 1.184 54.7%, 1.284 56%, 1.359 57.4%, 1.39 58.2%, 1.413 59%, 1.434 60.2%, 1.439 60.8%, 1.441 61.5%, 1.44 62.2%, 1.436 62.9%, 1.418 64.4%, 1.395 65.7%, 1.365 67.1%, 1.212 73.2%, 1.146 76.2%, 1.089 79.4%, 1.067 81%, 1.047 82.7%, 1.034 84.2%, 1.023 85.8%, 1.014 87.5%, 1.008 89.3%, 1.004 91.2%, 1.001 93.3%, 1);

    span {
      display: block;
      width: 100%;
      height: 2.5px;
      background: #676767;
      border-radius: 3px;
      opacity: 1;
      pointer-events: none !important;
      transition:
        transform 0.6s ease,
        opacity 0.3s;
    }

    &.active {
      transform: scale(1.15);

      span:first-child {
        transform: rotate(410deg) translate(0.5rem, 0.44rem);
      }
      span:nth-child(2) {
        opacity: 0;
      }
      span:last-child {
        transform: rotate(-410deg) translate(0.5rem, -0.44rem);
      }
    }

    &:hover span,
    &:focus-visible span {
      background: #707070;
    }

    @media (width > 68.75rem) {
      & {
        display: none;
      }
    }
  }

  .nav-bar {
    position: absolute;
    display: grid;
    place-content: center;
    background-color: var(--clr-white-10);
    font-size: var(--fs-nav-text);
    font-family: var(--ff-jakarta);
    font-weight: var(--fw-medium);
    padding: 2em;
    min-height: 100vh;
    text-align: center;
    text-transform: uppercase;
    inset: 0;
    margin-inline: auto;
    text-align: center;
    z-index: 1;
    user-select: none;
    -webkit-user-select: none;
    -ms-user-select: none;
    transform: translateX(-100%);
    transition: transform 0.5s ease-out;

    @media (width > 68.75rem) {
      position: relative;
      width: 100%;
      min-height: unset;
      background-color: inherit;
      padding: 0;
      z-index: 0;
      inset: unset;
      transform: translateY(0);

      & li:not(:last-of-type)::after {
        position: absolute;
        height: 0;
      }
    }

    ul {
      display: flex;
      flex-direction: column;
      justify-content: center;
      gap: 2rem;
      width: fit-content;
      margin-inline: auto;
      margin-bottom: 8rem;

      @media (width > 68.75rem) {
        flex-direction: row;
        gap: 2.5rem;
        margin-bottom: unset;
      }
    }

    a {
      transition:
        color 0.2s ease-out,
        opacity 0.2s ease-out;

      &:hover:not(.active-link) {
        opacity: 0.55;
      }

      &:focus-visible {
        opacity: 0.5;
      }

      &.active-link {
        color: #a27339;
      }
    }
  }

  .hamburger-btn__open {
    transform: translateY(-2px);
  }

  .nav-bar.no-transition {
    transition: none !important;
  }
</style>

<script>
  document.addEventListener("astro:page-load", () => {
    updateActiveNavLink();
    activateHamburgerMenu();
    initStickyHeader();
  });

  function activateHamburgerMenu() {
    const hamburgerBtn = document.querySelector(".hamburger-btn");
    const navBar = document.querySelector(".nav-bar");
    const navBarList = navBar.querySelector("ul");

    if (hamburgerBtn.dataset.initialized === "true") return;
    hamburgerBtn.dataset.initialized = "true";

    let isAnimating = false;

    function setNavAttributes() {
      const isOpen = navBar.classList.contains("hamburger-btn__open");

      navBar.setAttribute("aria-hidden", String(!isOpen));
      hamburgerBtn.setAttribute("aria-expanded", String(isOpen));

      navBar.querySelectorAll("a").forEach((link) => {
        link.tabIndex = isOpen ? 0 : -1;
      });

      if (!isOpen && navBar.contains(document.activeElement)) {
        document.activeElement.blur();
      }
    }

    hamburgerBtn.addEventListener("click", () => {
      if (isAnimating) return;

      isAnimating = true;

      const isOpen = navBar.classList.contains("hamburger-btn__open");

      if (isOpen) {
        hamburgerBtn.classList.remove("active");
        navBar.classList.remove("hamburger-btn__open");
      } else {
        navBar.style.display = "block";

        requestAnimationFrame(() => {
          hamburgerBtn.classList.add("active");
          navBar.classList.add("hamburger-btn__open");
          setNavAttributes();
        });
      }

      setNavAttributes();
    });

    navBar.addEventListener("transitionend", (event) => {
      if (event.target !== navBar || event.propertyName !== "transform") return;
      isAnimating = false;
    });

    document.addEventListener("click", (event) => {
      if (
        !navBar.classList.contains("hamburger-btn__open") ||
        navBar.contains(event.target) ||
        hamburgerBtn.contains(event.target)
      ) {
        return;
      }

      hamburgerBtn.classList.remove("active");
      navBar.classList.remove("hamburger-btn__open");
      setNavAttributes();
    });

    setNavAttributes();
  }

  function updateActiveNavLink() {
    const navBarLinks = document.querySelectorAll(".nav-bar a");
    const currentPath = window.location.pathname;

    navBarLinks.forEach((link) => {
      const linkPath = new URL(link.href).pathname;
      const isActive = linkPath === currentPath;

      link.classList.toggle("active-link", isActive);
      link.classList.remove("animate-underline");

      if (isActive) {
        requestAnimationFrame(() => {
          link.classList.add("animate-underline");
        });
      }
    });
  }

  function initStickyHeader() {
    const hamburgerBtn = document.querySelector(".hamburger-btn");
    const navBar = document.querySelector(".nav-bar");

    function closeMenuSafely() {
      navBar.classList.remove("hamburger-btn__open");
      hamburgerBtn.classList.remove("active");
    }

    window.addEventListener("scroll", () => {
      const header = document.querySelector("#header");
      const isScrolled = window.scrollY > 400;
      const headerWasSticking = header.classList.contains("sticking");

      if (isScrolled && !headerWasSticking) {
        header.classList.add("sticking");
        closeMenuSafely();
      } else if (window.scrollY < 5 && headerWasSticking) {
        header.classList.remove("sticking");
        closeMenuSafely();
      }
    });
  }
</script>
