---
import { Image } from "astro:assets";
import "swiper/css";
import "swiper/css/navigation";

import heroOne from "@assets/images/car-one.webp";
import heroTwo from "@assets/images/car-two.jpeg";
import heroThree from "@assets/images/car-three.webp";

const slides = [
  {
    src: heroOne,
    alt: "Viagem confortável numa carrinha executiva no Algarve",
  },
  {
    src: heroTwo,
    alt: "Paisagem costeira do Algarve",
  },
  {
    src: heroThree,
    alt: "Alojamento preparado para uma estadia no Algarve",
  },
];
---

<div class="rental-slider" aria-label="Galeria de imagens">
  <div class="swiper rental-slider__swiper">
    <div class="swiper-wrapper">
      {slides.map((slide, index) => (
        <div class="swiper-slide">
          <Image
            src={slide.src}
            alt={slide.alt}
            format="webp"
            quality={85}
            loading={index === 0 ? "eager" : "lazy"}
            fetchpriority={index === 0 ? "high" : "auto"}
            class="rental-slider__image"
          />
        </div>
      ))}
    </div>
  </div>
</div>

<style>
  .rental-slider {
    position: relative;
    width: 100%;
    overflow: hidden;
    border-radius: 8px;
    box-shadow: var(--box-shadow-10);
  }

  .rental-slider__swiper {
    width: 100%;
    overflow: hidden;
  }

  .rental-slider__swiper .swiper-slide {
    height: 100%;
    overflow: clip;
  }

  .rental-slider__swiper .swiper-slide::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgb(0 0 0 / 75%) 0%,
      rgb(0 0 0 / 45%) 30%,
      rgb(0 0 0 / 10%) 45%,
      transparent 100%
    );
    pointer-events: none;
  }

  :global(.rental-slider__image) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 100% 60%;
  }
</style>
