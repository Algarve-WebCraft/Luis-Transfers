  },
  {
    name: "Lagos, Portugal",
    price: "€59",
    distance: "85km",
    time: "57m",
    placeId: "ChIJjU0jUEkwGw0RV_waR6OqEFQ",
  },
  {
    name: "Luz, Portugal",
    price: "€64",
    distance: "91km",
    time: "1h 03m",
    placeId: "ChIJEz67Bj4xGw0RCdaIxNlkeO8",
  },
  {
    name: "Portimão, Portugal",
    price: "€49",
    distance: "66km",
