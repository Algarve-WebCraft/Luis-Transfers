  },
  {
    name: "Alvor, Portugal",
    price: "€49",
    distance: "74km",
    time: "48m",
    placeId: "ChIJt2L-4hUvGw0RXHpRwBV_EAo",
  },
  {
    name: "Armação de Pêra, Portugal",
    price: "€37",
