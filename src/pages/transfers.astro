---
import BaseLayout from "@layouts/BaseLayout.astro";
import RoutesCards from "@components/other/RoutesCards.astro";
import TransferForm from "@components/other/TransferForm.astro";

const { locale } = Astro.props;

const pageTitle = "Transfers | Luis Ferreira Transfers & Services";
const pageDescription =
  "Book private transfers throughout the Iberian Peninsula, including pick-ups at Faro Airport and journeys to Lisbon and Seville. A direct and reliable service.";
---

<BaseLayout pageTitle={pageTitle} pageDescription={pageDescription} bodyClass="secondary-page">
  <section class="cmp-hero-section" aria-labelledby="hero-section">
    <div class="wrapper wrapper--tablet-48">
      <div class="hero__text-container">
        <span class="cmp-topper-heading">•&nbsp; Official transfer service &nbsp;•&nbsp; RNAVT No. 11744</span>
        <h1 id="hero-section" class="cmp-hero-heading">
          Private & Executive Transfers
        </h1>
        <p class="cmp-main-text">
          Book your transfer in the Algarve with a dedicated driver, exceptional comfort, personalised service and
          punctuality you can rely on.
        </p>

        <div class="hero-bottom-container">
          <span>
            <svg viewBox="0 0 17 12">
              <path
                d="M9.75 6.75C9.125 6.75 8.59375 6.53125 8.15625 6.09375C7.71875 5.65625 7.5 5.125 7.5 4.5C7.5 3.875 7.71875 3.34375 8.15625 2.90625C8.59375 2.46875 9.125 2.25 9.75 2.25C10.375 2.25 10.9062 2.46875 11.3438 2.90625C11.7812 3.34375 12 3.875 12 4.5C12 5.125 11.7812 5.65625 11.3438 6.09375C10.9062 6.53125 10.375 6.75 9.75 6.75ZM4.5 9C4.0875 9 3.73438 8.85312 3.44062 8.55937C3.14687 8.26562 3 7.9125 3 7.5V1.5C3 1.0875 3.14687 0.734375 3.44062 0.440625C3.73438 0.146875 4.0875 0 4.5 0H15C15.4125 0 15.7656 0.146875 16.0594 0.440625C16.3531 0.734375 16.5 1.0875 16.5 1.5V7.5C16.5 7.9125 16.3531 8.26562 16.0594 8.55937C15.7656 8.85312 15.4125 9 15 9H4.5ZM6 7.5H13.5C13.5 7.0875 13.6469 6.73438 13.9406 6.44063C14.2344 6.14688 14.5875 6 15 6V3C14.5875 3 14.2344 2.85313 13.9406 2.55938C13.6469 2.26562 13.5 1.9125 13.5 1.5H6C6 1.9125 5.85312 2.26562 5.55937 2.55938C5.26562 2.85313 4.9125 3 4.5 3V6C4.9125 6 5.26562 6.14688 5.55937 6.44063C5.85312 6.73438 6 7.0875 6 7.5ZM14.25 12H1.5C1.0875 12 0.734375 11.8531 0.440625 11.5594C0.146875 11.2656 0 10.9125 0 10.5V2.25H1.5V10.5H14.25V12ZM4.5 7.5V1.5V7.5Z"
                fill="#7A582F"
              />
            </svg>
            <span>Pay Your Driver Directly</span>
          </span>

          <span>
            <svg viewBox="0 0 17 19">
              <path
                d="M0 18.5167V16.6833H16.5V18.5167H0V18.5167M14.2542 13.8875L0 9.83125V3.1625L2.2 3.78125L3.3 6.96667L6.4625 7.86042L5.66042 0L8.29583 0.779167L11.2292 9.23542L15.1708 10.3583C15.5528 10.4806 15.8698 10.7021 16.1219 11.0229C16.374 11.3438 16.5 11.7104 16.5 12.1229C16.5 12.6576 16.2823 13.1274 15.8469 13.5323C15.4115 13.9372 14.8806 14.0556 14.2542 13.8875V13.8875"
                fill="#7A582F"
              />
            </svg>

            <span>Airport Meet & Greet</span>
          </span>

          <span>
            <svg viewBox="0 0 15 15">
              <path
                d="M3.75 15V13.125L6 11.55V8.85L0 11.25V9L6 4.8V1.5C6 1.0875 6.14688 0.734375 6.44063 0.440625C6.73438 0.146875 7.0875 0 7.5 0C7.9125 0 8.26562 0.146875 8.55937 0.440625C8.85312 0.734375 9 1.0875 9 1.5V4.8L15 9V11.25L9 8.85V11.55L11.25 13.125V15L7.5 13.875L3.75 15Z"
                fill="#7A582F"
              />
            </svg>
            <span>Flight Monitoring</span>
          </span>

          <span>
            <svg viewBox="0 0 15 15">
              <path
                d="M9.4125 10.9125L6.75 8.25V4.5H8.25V7.63125L10.4625 9.84375L9.4125 10.9125ZM6.75 3V1.5H8.25V3H6.75ZM12 8.25V6.75H13.5V8.25H12ZM6.75 13.5V12H8.25V13.5H6.75ZM1.5 8.25V6.75H3V8.25H1.5ZM7.5 15C6.4625 15 5.4875 14.8031 4.575 14.4094C3.6625 14.0156 2.86875 13.4812 2.19375 12.8062C1.51875 12.1312 0.984375 11.3375 0.590625 10.425C0.196875 9.5125 0 8.5375 0 7.5C0 6.4625 0.196875 5.4875 0.590625 4.575C0.984375 3.6625 1.51875 2.86875 2.19375 2.19375C2.86875 1.51875 3.6625 0.984375 4.575 0.590625C5.4875 0.196875 6.4625 0 7.5 0C8.5375 0 9.5125 0.196875 10.425 0.590625C11.3375 0.984375 12.1312 1.51875 12.8062 2.19375C13.4812 2.86875 14.0156 3.6625 14.4094 4.575C14.8031 5.4875 15 6.4625 15 7.5C15 8.5375 14.8031 9.5125 14.4094 10.425C14.0156 11.3375 13.4812 12.1312 12.8062 12.8062C12.1312 13.4812 11.3375 14.0156 10.425 14.4094C9.5125 14.8031 8.5375 15 7.5 15ZM7.5 13.5C9.175 13.5 10.5938 12.9188 11.7563 11.7563C12.9188 10.5938 13.5 9.175 13.5 7.5C13.5 5.825 12.9188 4.40625 11.7563 3.24375C10.5938 2.08125 9.175 1.5 7.5 1.5C5.825 1.5 4.40625 2.08125 3.24375 3.24375C2.08125 4.40625 1.5 5.825 1.5 7.5C1.5 9.175 2.08125 10.5938 3.24375 11.7563C4.40625 12.9188 5.825 13.5 7.5 13.5Z"
                fill="#7A582F"
              />
            </svg>
            <span>No Charges for Delays</span>
          </span>
        </div>
      </div>
    </div>
  </section>

  <section class="cmp-main-section" id="jump-to-transfer" aria-labelledby="transfer-section">
    <div class="wrapper wrapper--mobile-40 wrapper--tablet-48">
      <div class="transfer-section-container">
        <div class="transfer-form-container">
          <span class="cmp-topper-heading">FAST RESPONSE • EASY BOOKING</span>
          <h2 id="transfer-section" class="cmp-main-heading">
            Request Your Transfer
          </h2>

          <TransferForm locale={locale} layout="compact" />
          <p id="status" aria-live="polite"></p>
        </div>

        <div class="transfer-side-container">
          <div class="side-container-block">
            <span class="cmp-topper-heading">PARKING</span>
            <h2 class="cmp-small-heading">Faro Airport Terminal</h2>
            <p class="cmp-body-mini-text">
              Exclusive access to the terminal's VIP arrivals area, ensuring a more convenient, direct and personalised
              passenger pick-up.
            </p>
            <span>+ €7.00</span>
          </div>

          <div class="side-container-block">
            <span class="cmp-topper-heading">NIGHT-TIME TRANSFERS</span>
            <h2 class="cmp-small-heading">Hours 22:00 — 06:00</h2>
            <p class="cmp-body-mini-text">
              Reliable punctuality and dedicated night-time assistance, with full availability and personalised support
              for journeys at any time of day or night.
            </p>
            <span>+ €10.00</span>
          </div>

          <div class="side-container-block">
            <span class="cmp-topper-heading">EARLY HOURS</span>
            <h2 class="cmp-small-heading">Hours 00:00 — 04:00</h2>
            <p class="cmp-body-mini-text">
              Dedicated 24-hour availability, with personalised support and assistance for late arrivals, ensuring a
              smooth journey at any time.
            </p>
            <span>+ €15.00</span>
          </div>

          <div class="side-container-block">
            <span class="cmp-topper-heading">LONG-DISTANCE TRANSFERS</span>
            <h2 class="cmp-small-heading">Lisbon / Seville</h2>
            <p class="cmp-body-mini-text">
              Long-distance transfers to Lisbon and Seville airports, with tolls included and maximum comfort throughout
              the journey.
            </p>
            <span>From €220</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="cmp-main-section" aria-labelledby="popular-routes-section">
    <div class="wrapper wrapper--mobile-40" data-animate="fade-in">
      <div class="popular-routes-container">
        <div class="popular-routes__text">
          <span class="cmp-topper-heading">Fixed routes at affordable prices</span>
          <h2 id="popular-routes-section" class="cmp-main-heading">
            13 Popular Fixed Routes to Faro Airport
          </h2>
        </div>

        <p class="cmp-body-text">
          Fixed prices for journeys to and from Faro Airport, for up to 4 passengers with luggage. Select your preferred
          fixed route to automatically fill in the journey details in the booking form above.
        </p>
      </div>

      <RoutesCards gridContainerWidth="17rem" />
    </div>
  </section>

  <section class="cmp-main-section" aria-labelledby="location-section">
    <div class="wrapper wrapper--mobile-32" data-animate="fade-in">
      <div class="location-container">
        <div class="location__text">
          <span class="cmp-topper-heading">CENTRALLY LOCATED</span>
          <h2 id="location-section" class="cmp-main-heading">
            Based in Carvoeiro, Connected Across the Algarve
          </h2>
          <p class="cmp-body-text">
            Strategically based in Carvoeiro (Lagoa), we ensure rapid response times for pick-ups in Ferragudo, Alvor,
            Portimão and arrivals at Faro International Airport.
          </p>

          <div class="location__text__list">
            <span>
              <svg viewBox="0 0 17 17">
                <path
                  d="M7.16667 12.1667L13.0417 6.29167L11.875 5.125L7.16667 9.83333L4.79167 7.45833L3.625 8.625L7.16667 12.1667ZM8.33333 16.6667C7.18056 16.6667 6.09722 16.4479 5.08333 16.0104C4.06944 15.5729 3.1875 14.9792 2.4375 14.2292C1.6875 13.4792 1.09375 12.5972 0.65625 11.5833C0.21875 10.5694 0 9.48611 0 8.33333C0 7.18056 0.21875 6.09722 0.65625 5.08333C1.09375 4.06944 1.6875 3.1875 2.4375 2.4375C3.1875 1.6875 4.06944 1.09375 5.08333 0.65625C6.09722 0.21875 7.18056 0 8.33333 0C9.48611 0 10.5694 0.21875 11.5833 0.65625C12.5972 1.09375 13.4792 1.6875 14.2292 2.4375C14.9792 3.1875 15.5729 4.06944 16.0104 5.08333C16.4479 6.09722 16.6667 7.18056 16.6667 8.33333C16.6667 9.48611 16.4479 10.5694 16.0104 11.5833C15.5729 12.5972 14.9792 13.4792 14.2292 14.2292C13.4792 14.9792 12.5972 15.5729 11.5833 16.0104C10.5694 16.4479 9.48611 16.6667 8.33333 16.6667ZM8.33333 15C10.1944 15 11.7708 14.3542 13.0625 13.0625C14.3542 11.7708 15 10.1944 15 8.33333C15 6.47222 14.3542 4.89583 13.0625 3.60417C11.7708 2.3125 10.1944 1.66667 8.33333 1.66667C6.47222 1.66667 4.89583 2.3125 3.60417 3.60417C2.3125 4.89583 1.66667 6.47222 1.66667 8.33333C1.66667 10.1944 2.3125 11.7708 3.60417 13.0625C4.89583 14.3542 6.47222 15 8.33333 15Z"
                  fill="#7A582F"
                />
              </svg>

              <span>Professional drivers with experience and in-depth knowledge of the Algarve</span>
            </span>

            <span>
              <svg viewBox="0 0 17 17">
                <path
                  d="M7.16667 12.1667L13.0417 6.29167L11.875 5.125L7.16667 9.83333L4.79167 7.45833L3.625 8.625L7.16667 12.1667ZM8.33333 16.6667C7.18056 16.6667 6.09722 16.4479 5.08333 16.0104C4.06944 15.5729 3.1875 14.9792 2.4375 14.2292C1.6875 13.4792 1.09375 12.5972 0.65625 11.5833C0.21875 10.5694 0 9.48611 0 8.33333C0 7.18056 0.21875 6.09722 0.65625 5.08333C1.09375 4.06944 1.6875 3.1875 2.4375 2.4375C3.1875 1.6875 4.06944 1.09375 5.08333 0.65625C6.09722 0.21875 7.18056 0 8.33333 0C9.48611 0 10.5694 0.21875 11.5833 0.65625C12.5972 1.09375 13.4792 1.6875 14.2292 2.4375C14.9792 3.1875 15.5729 4.06944 16.0104 5.08333C16.4479 6.09722 16.6667 7.18056 16.6667 8.33333C16.6667 9.48611 16.4479 10.5694 16.0104 11.5833C15.5729 12.5972 14.9792 13.4792 14.2292 14.2292C13.4792 14.9792 12.5972 15.5729 11.5833 16.0104C10.5694 16.4479 9.48611 16.6667 8.33333 16.6667ZM8.33333 15C10.1944 15 11.7708 14.3542 13.0625 13.0625C14.3542 11.7708 15 10.1944 15 8.33333C15 6.47222 14.3542 4.89583 13.0625 3.60417C11.7708 2.3125 10.1944 1.66667 8.33333 1.66667C6.47222 1.66667 4.89583 2.3125 3.60417 3.60417C2.3125 4.89583 1.66667 6.47222 1.66667 8.33333C1.66667 10.1944 2.3125 11.7708 3.60417 13.0625C4.89583 14.3542 6.47222 15 8.33333 15Z"
                  fill="#7A582F"
                />
              </svg>

              <span>Direct access and drop-off at the door of your villa or hotel</span>
            </span>

            <span>
              <svg viewBox="0 0 17 17">
                <path
                  d="M7.16667 12.1667L13.0417 6.29167L11.875 5.125L7.16667 9.83333L4.79167 7.45833L3.625 8.625L7.16667 12.1667ZM8.33333 16.6667C7.18056 16.6667 6.09722 16.4479 5.08333 16.0104C4.06944 15.5729 3.1875 14.9792 2.4375 14.2292C1.6875 13.4792 1.09375 12.5972 0.65625 11.5833C0.21875 10.5694 0 9.48611 0 8.33333C0 7.18056 0.21875 6.09722 0.65625 5.08333C1.09375 4.06944 1.6875 3.1875 2.4375 2.4375C3.1875 1.6875 4.06944 1.09375 5.08333 0.65625C6.09722 0.21875 7.18056 0 8.33333 0C9.48611 0 10.5694 0.21875 11.5833 0.65625C12.5972 1.09375 13.4792 1.6875 14.2292 2.4375C14.9792 3.1875 15.5729 4.06944 16.0104 5.08333C16.4479 6.09722 16.6667 7.18056 16.6667 8.33333C16.6667 9.48611 16.4479 10.5694 16.0104 11.5833C15.5729 12.5972 14.9792 13.4792 14.2292 14.2292C13.4792 14.9792 12.5972 15.5729 11.5833 16.0104C10.5694 16.4479 9.48611 16.6667 8.33333 16.6667ZM8.33333 15C10.1944 15 11.7708 14.3542 13.0625 13.0625C14.3542 11.7708 15 10.1944 15 8.33333C15 6.47222 14.3542 4.89583 13.0625 3.60417C11.7708 2.3125 10.1944 1.66667 8.33333 1.66667C6.47222 1.66667 4.89583 2.3125 3.60417 3.60417C2.3125 4.89583 1.66667 6.47222 1.66667 8.33333C1.66667 10.1944 2.3125 11.7708 3.60417 13.0625C4.89583 14.3542 6.47222 15 8.33333 15Z"
                  fill="#7A582F"
                />
              </svg>

              <span>24-hour availability by prior arrangement</span>
            </span>
          </div>
        </div>

        <iframe
          src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d25455.53854996203!2d-8.482433212557522!3d37.106490518290926!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0xd1ad616f4493751%3A0x3e5203cb638bef7d!2sCarvoeiro!5e0!3m2!1sen!2spt!4v1792161526033!5m2!1sen!2spt"
          title="Business location"
          allowfullscreen
          loading="lazy"
          referrerpolicy="strict-origin-when-cross-origin"
        ></iframe>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero__text-container {
    @media (width > 47.5rem) {
      text-align: center;
    }

    p {
      max-width: 50ch;

      @media (width > 47.5rem) {
        max-width: 55ch;
        margin-inline: auto;
      }
    }

    .hero-bottom-container {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1rem;
      row-gap: 2rem;
      position: relative;
      font-size: var(--fs-13);
      color: var(--clr-black-40);
      margin-bottom: 4rem;
      margin-top: 3rem;
      line-height: var(--lh-155);

      @media (width > 62.5rem) {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 4rem;
        white-space: nowrap;
      }

      &::after {
        content: "";
        position: absolute;
        display: block;
        top: 140%;
        width: 100%;
        height: 1px;
        background-color: var(--clr-black-40);
        opacity: 0.1;

        @media (width > 47.5rem) {
          top: 7rem;
        }

        @media (width > 62.5rem) {
          top: 5.5rem;
        }
      }

      > span {
        display: flex;
        align-items: center;

        @media (width > 47.5rem) {
          display: block;
        }
      }

      svg {
        position: relative;
        width: 1rem;
        min-width: 1rem;
        margin-right: 0.5rem;
      }
    }
  }

  .transfer-section-container {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 3rem;

    @media (width > 62.5rem) {
      flex-direction: row;
      margin-bottom: 2rem;
    }

    .transfer-form-container {
      width: 100%;
      padding: 1.5rem;
      background: rgba(255, 255, 255, 0);
      margin-top: -5rem;
      border-radius: 8px;
      box-shadow: var(--box-shadow-10);

      @media (width > 62.5rem) {
        max-width: 62%;
        margin-top: unset;
        padding: 3rem;
      }

      a,
      button {
        max-width: 35ch;
      }
    }

    .transfer-side-container {
      display: grid;
      grid-template-columns: 1fr;
      place-items: center;
      gap: 1rem;

      h2 {
        margin-bottom: 0.5rem;
      }

      @media (width > 47.5rem) {
        grid-template-columns: 1fr 1fr;
      }

      @media (width > 62.5rem) {
        display: flex;
        flex-direction: column;
      }

      .side-container-block {
        width: 100%;
        max-width: 26rem;
        align-self: end;
        padding: 1.5em 1em;
        border-radius: 8px;
        box-shadow: var(--box-shadow-10);
        transition: transform 0.3s ease-out;

        span:last-of-type {
          display: inline-block;
          font-size: var(--fs-22);
          font-family: var(--ff-news);
          font-weight: var(--fw-semibold);
          line-height: var(--lh-125);
          letter-spacing: var(--ls-pos-5);
          margin-top: 2rem;
        }

        &:last-child {
          background-color: var(--clr-black-20);

          h2,
          p {
            color: var(--clr-white-10);
          }

          p {
            opacity: 0.8;
          }

          span {
            color: var(--clr-beige-10);
          }
        }

        &:hover {
          transform: translateY(-0.2rem);
        }
      }
    }
  }

  .popular-routes-container {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 2rem;

    @media (width > 47.5rem) {
      flex-direction: row;
      margin-bottom: 5rem;
      gap: 4rem;
    }

    p {
      @media (width > 47.5rem) {
        max-width: 40%;
        align-self: end;
      }
    }
  }

  .location-container {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;

    @media (width > 47.5rem) {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }

    .location__text {
      max-width: 40ch;

      .location__text__list {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        margin-top: 1.5rem;

        span {
          display: flex;
          align-items: center;
        }

        svg {
          min-width: 1rem;
          width: 1rem;
          margin-right: 0.5rem;
        }
      }
    }

    iframe {
      height: 100%;
      max-height: 13rem;
      aspect-ratio: 16 / 9;
      border-radius: 8px;
      box-shadow: var(--box-shadow-10);

      @media (width > 47.5rem) {
        width: 55%;
        max-height: 31rem;
        aspect-ratio: 1 / 2;
      }
    }
  }
</style>

<script>
  import "@scripts/formLogic.js";
</script>
