---
import BaseLayout from "@layouts/BaseLayout.astro";

const pageTitle = "Confirmação | Luis Ferreira Transferências e Serviços";
const pageDescription = "Page Description";
---

<BaseLayout pageTitle={pageTitle} pageDescription={pageDescription} bodyClass="secondary-page">
  <section class="cmp-hero-section" aria-labelledby="confirm-section">
    <div class="wrapper wrapper--mobile-m wrapper--1080">
      <div class="confirm-container">
        <div class="confirm__text">
          <div>
            <span class="cmp-topper-heading">• CARVOEIRO • ALGARVE</span>
            <h1 id="confirm-section" class="cmp-hero-heading">
              Pedido de Transfer Enviado
            </h1>
          </div>

          <div>
            <p class="cmp-main-text">
              Sua solicitação de traslado foi enviada com sucesso. Analisaremos os detalhes da viagem e entraremos em
              contato em breve com a confirmação. Por favor, entre em contato conosco diretamente caso não receba uma
              resposta em até &nbsp;<strong>4 horas</strong>.
            </p>
          </div>

          <a href="/pt/" class="go-back-button">
            <svg viewBox="0 0 12 12">
              <path
                d="M2.86875 6.75L7.06875 10.95L6 12L0 6L6 0L7.06875 1.05L2.86875 5.25H12V6.75H2.86875Z"
                fill="black"
              />
            </svg>
            VOLTAR AO SITE PRINCIPAL
          </a>
        </div>

        <div class="confirm__blocks">
          <div>
            <h2 class="cmp-small-heading">
              <svg viewBox="0 0 13 14">
                <path
                  d="M1.875 9V8.25H0V6.75H3.75V5.25H0.75C0.5375 5.25 0.359375 5.17813 0.215625 5.03438C0.071875 4.89062 0 4.7125 0 4.5V1.5C0 1.2875 0.071875 1.10938 0.215625 0.965625C0.359375 0.821875 0.5375 0.75 0.75 0.75H1.875V0H3.375V0.75H5.25V2.25H1.5V3.75H4.5C4.7125 3.75 4.89062 3.82188 5.03438 3.96563C5.17813 4.10938 5.25 4.2875 5.25 4.5V7.5C5.25 7.7125 5.17813 7.89062 5.03438 8.03438C4.89062 8.17813 4.7125 8.25 4.5 8.25H3.375V9H1.875ZM7.4625 13.5L4.275 10.3125L5.325 9.2625L7.4625 11.4L11.7 7.1625L12.75 8.2125L7.4625 13.5Z"
                  fill="#191C1D"
                />
              </svg>
              TRANSPARÊNCIA
            </h2>
            <p class="cmp-body-mini-text">Tarifas fixas e transparentes sem custos ocultos ou extras de espera.</p>
          </div>

          <div>
            <h2 class="cmp-small-heading">
              <svg viewBox="0 0 16 14">
                <path
                  d="M1.5 13.6125V12.1125H15V13.6125H1.5ZM2.8125 9.8625L0 5.175L1.8 4.6875L3.9 6.45L6.525 5.75625L2.64375 0.58125L4.81875 0L10.425 4.70625L13.6125 3.84375C14.0125 3.73125 14.3906 3.77813 14.7469 3.98438C15.1031 4.19063 15.3375 4.49375 15.45 4.89375C15.5625 5.29375 15.5156 5.67188 15.3094 6.02812C15.1031 6.38437 14.8 6.61875 14.4 6.73125L2.8125 9.8625Z"
                  fill="#191C1D"
                />
              </svg>
              PONTUALIDADE
            </h2>
            <p class="cmp-body-mini-text">Pontualidade garantida e cumprimento rigoroso dos horários acordados.</p>
          </div>

          <div>
            <h2 class="cmp-small-heading">
              <svg viewBox="0 0 17 12">
                <path
                  d="M9.75 6.75C9.125 6.75 8.59375 6.53125 8.15625 6.09375C7.71875 5.65625 7.5 5.125 7.5 4.5C7.5 3.875 7.71875 3.34375 8.15625 2.90625C8.59375 2.46875 9.125 2.25 9.75 2.25C10.375 2.25 10.9062 2.46875 11.3438 2.90625C11.7812 3.34375 12 3.875 12 4.5C12 5.125 11.7812 5.65625 11.3438 6.09375C10.9062 6.53125 10.375 6.75 9.75 6.75ZM4.5 9C4.0875 9 3.73438 8.85312 3.44062 8.55937C3.14687 8.26562 3 7.9125 3 7.5V1.5C3 1.0875 3.14687 0.734375 3.44062 0.440625C3.73438 0.146875 4.0875 0 4.5 0H15C15.4125 0 15.7656 0.146875 16.0594 0.440625C16.3531 0.734375 16.5 1.0875 16.5 1.5V7.5C16.5 7.9125 16.3531 8.26562 16.0594 8.55937C15.7656 8.85312 15.4125 9 15 9H4.5ZM6 7.5H13.5C13.5 7.0875 13.6469 6.73438 13.9406 6.44063C14.2344 6.14688 14.5875 6 15 6V3C14.5875 3 14.2344 2.85313 13.9406 2.55938C13.6469 2.26562 13.5 1.9125 13.5 1.5H6C6 1.9125 5.85312 2.26562 5.55937 2.55938C5.26562 2.85313 4.9125 3 4.5 3V6C4.9125 6 5.26562 6.14688 5.55937 6.44063C5.85312 6.73438 6 7.0875 6 7.5ZM14.25 12H1.5C1.0875 12 0.734375 11.8531 0.440625 11.5594C0.146875 11.2656 0 10.9125 0 10.5V2.25H1.5V10.5H14.25V12ZM4.5 7.5V1.5V7.5Z"
                  fill="#191C1D"
                />
              </svg>
              FLEXIBILIDADE
            </h2>
            <p class="cmp-body-mini-text">Pagamento direto ao motorista Numerário no destino.</p>
          </div>
        </div>

        <div class="confirm__contact">
          <div>
            <span class="cmp-topper-heading">
              <svg viewBox="0 0 17 17">
                <path
                  d="M11.0833 12.25L12.25 11.0833L9.16667 8V4.16667H7.5V8.66667L11.0833 12.25ZM8.33333 16.6667C7.18056 16.6667 6.09722 16.4479 5.08333 16.0104C4.06944 15.5729 3.1875 14.9792 2.4375 14.2292C1.6875 13.4792 1.09375 12.5972 0.65625 11.5833C0.21875 10.5694 0 9.48611 0 8.33333C0 7.18056 0.21875 6.09722 0.65625 5.08333C1.09375 4.06944 1.6875 3.1875 2.4375 2.4375C3.1875 1.6875 4.06944 1.09375 5.08333 0.65625C6.09722 0.21875 7.18056 0 8.33333 0C9.48611 0 10.5694 0.21875 11.5833 0.65625C12.5972 1.09375 13.4792 1.6875 14.2292 2.4375C14.9792 3.1875 15.5729 4.06944 16.0104 5.08333C16.4479 6.09722 16.6667 7.18056 16.6667 8.33333C16.6667 9.48611 16.4479 10.5694 16.0104 11.5833C15.5729 12.5972 14.9792 13.4792 14.2292 14.2292C13.4792 14.9792 12.5972 15.5729 11.5833 16.0104C10.5694 16.4479 9.48611 16.6667 8.33333 16.6667ZM8.33333 15C10.1806 15 11.7535 14.3507 13.0521 13.0521C14.3507 11.7535 15 10.1806 15 8.33333C15 6.48611 14.3507 4.91319 13.0521 3.61458C11.7535 2.31597 10.1806 1.66667 8.33333 1.66667C6.48611 1.66667 4.91319 2.31597 3.61458 3.61458C2.31597 4.91319 1.66667 6.48611 1.66667 8.33333C1.66667 10.1806 2.31597 11.7535 3.61458 13.0521C4.91319 14.3507 6.48611 15 8.33333 15Z"
                  fill="#7A582F"
                />
              </svg>
              NECESSITA DE ALTERAÇÃO IMEDIATA?
            </span>
            <h3>Apoio Direto & Urgências 24 Horas</h3>
            <p class="cmp-body-mini-text">
              Caso surja algum imprevisto ou necessito de alterar algum detalhe da sua viagem, pedimos que entre em
              contacto connosco o mais brevemente possível.
            </p>
          </div>

          <div class="confirm__contact-button-container">
            <a
              href="https://wa.me/351966831360"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Contact us on WhatsApp"
              class="cmp-main-btn"
            >
              <svg viewBox="0 0 512 512">
                <rect width="512" height="512" rx="15%" fill="#25d366"></rect>
                <path fill="#25d366" stroke="#ffffff" stroke-width="26" d="M123 393l14-65a138 138 0 1150 47z"></path>
                <path
                  fill="#ffffff"
                  d="M308 273c-3-2-6-3-9 1l-12 16c-3 2-5 3-9 1-15-8-36-17-54-47-1-4 1-6 3-8l9-14c2-2 1-4 0-6l-12-29c-3-8-6-7-9-7h-8c-2 0-6 1-10 5-22 22-13 53 3 73 3 4 23 40 66 59 32 14 39 12 48 10 11-1 22-10 27-19 1-3 6-16 2-18"
                ></path>
              </svg>
              WHATSAPP DIRETO
            </a>

            <a href="tel:+351966831360" class="cmp-main-btn">
              <svg viewBox="0 0 14 14">
                <path
                  d="M12.7125 13.5C11.15 13.5 9.60625 13.1594 8.08125 12.4781C6.55625 11.7969 5.16875 10.8313 3.91875 9.58125C2.66875 8.33125 1.70312 6.94375 1.02188 5.41875C0.340625 3.89375 0 2.35 0 0.7875C0 0.5625 0.075 0.375 0.225 0.225C0.375 0.075 0.5625 0 0.7875 0H3.825C4 0 4.15625 0.059375 4.29375 0.178125C4.43125 0.296875 4.5125 0.4375 4.5375 0.6L5.025 3.225C5.05 3.425 5.04375 3.59375 5.00625 3.73125C4.96875 3.86875 4.9 3.9875 4.8 4.0875L2.98125 5.925C3.23125 6.3875 3.52813 6.83437 3.87188 7.26562C4.21562 7.69688 4.59375 8.1125 5.00625 8.5125C5.39375 8.9 5.8 9.25937 6.225 9.59062C6.65 9.92188 7.1 10.225 7.575 10.5L9.3375 8.7375C9.45 8.625 9.59688 8.54062 9.77812 8.48438C9.95937 8.42813 10.1375 8.4125 10.3125 8.4375L12.9 8.9625C13.075 9.0125 13.2188 9.10312 13.3313 9.23438C13.4438 9.36563 13.5 9.5125 13.5 9.675V12.7125C13.5 12.9375 13.425 13.125 13.275 13.275C13.125 13.425 12.9375 13.5 12.7125 13.5ZM2.26875 4.5L3.50625 3.2625L3.1875 1.5H1.51875C1.58125 2.0125 1.66875 2.51875 1.78125 3.01875C1.89375 3.51875 2.05625 4.0125 2.26875 4.5ZM8.98125 11.2125C9.46875 11.425 9.96562 11.5938 10.4719 11.7188C10.9781 11.8438 11.4875 11.925 12 11.9625V10.3125L10.2375 9.95625L8.98125 11.2125Z"
                  fill="#7A582F"
                />
              </svg>
              +351 966 831 360
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .confirm-container {
    text-align: center;

    .confirm__text {
      p {
        max-width: 60ch;
        margin-inline: auto;
      }

      .go-back-button {
        display: inline-block;
        font-size: var(--fs-13);
        font-weight: var(--fw-semibold);
        margin-top: 1.5rem;
        text-transform: uppercase;
        white-space: nowrap;
        transition:
          transform 0.3s ease-in-out,
          opacity 0.1s ease-in-out;

        &:hover {
          translate: 0 -1px;
          opacity: 0.6;
        }

        svg {
          max-width: 0.75rem;
          margin-right: 0.5rem;
        }
      }

      &::after {
        content: "";
        display: block;
        width: 80%;
        height: 1px;
        background-color: #00000016;
        margin-top: 3rem;
        margin-inline: auto;

        @media (width > 47.5rem) {
          margin-top: 4rem;
        }
      }
    }

    .confirm__blocks {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 1rem;
      margin-block: 2.5rem;
      text-align: center;

      @media (width > 40rem) {
        flex-direction: row;
        justify-content: space-around;
        margin-left: 2rem;
        margin-block: 4rem;
        text-align: left;
      }

      h2 {
        color: var(--clr-brown-10);
        margin-bottom: 0.5rem;

        svg {
          position: relative;
          max-width: 2rem;
          background-color: #edeeef;
          margin-right: 0.15rem;
          top: 0.6rem;
          right: 0.25rem;
          border-radius: 8px;
          padding: 0.5em;
        }
      }

      p {
        max-width: 35ch;

        @media (width > 40rem) {
          max-width: 20ch;
        }
      }
    }
  }

  .confirm__contact {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    background: var(--clr-black-20);
    color: var(--clr-white-10);
    padding: 1.5rem 2.5rem;
    border-radius: 4px;
    text-align: center;

    @media (width > 47.5rem) {
      flex-direction: row;
      justify-content: space-around;
      margin-left: 2rem;
      text-align: left;
    }

    h3 {
      font-size: 1rem;
      font-weight: var(--fw-semibold);
      line-height: var(--lh-145);
      margin-top: 0.25rem;
      margin-bottom: 1rem;
    }

    p {
      margin-inline: auto;
      margin-bottom: 2rem;

      @media (width > 47.5rem) {
        max-width: 60%;
        margin-inline: unset;
        margin-bottom: unset;
      }
    }

    span svg {
      position: absolute;
      max-width: 1.25rem;
      left: 0.75rem;
      top: 1.75rem;
    }

    .confirm__contact-button-container {
      display: flex;
      flex-direction: column;
      gap: 1rem;

      a {
        min-width: 13.25rem;
        font-size: var(--fs-15);
        background-color: var(--clr-white-10);
        color: var(--clr-black-10);
        width: fit-content;
        white-space: nowrap;
        padding-right: 3em;
        padding-bottom: 1em;
      }

      svg {
        position: relative;
        max-width: 1.3rem;
        right: 0.6rem;
        top: 0.25rem;
      }
    }
  }
</style>
