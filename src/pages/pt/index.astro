            font-size: var(--fs-18);
            font-weight: var(--fw-semibold);
            color: var(--clr-brown-10);
            line-height: var(--lh-145);
          }

          span:last-child {
            font-size: var(--fs-13);
            font-weight: var(--fw-regular);
            color: var(--clr-black-40);
            line-height: var(--lh-155);
          }
        }
      }

      .card-bottom-spans {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        margin-top: -0.5rem;

