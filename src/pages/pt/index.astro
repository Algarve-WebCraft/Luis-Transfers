        border-radius: 8px;
        border: 2px solid #edeeef;
        box-shadow: var(--box-shadow-20);
        transition: translate 0.2s ease-out;

        &:hover {
          translate: 0 -0.15rem;
        }

        @media (width > 47.5rem) {
          flex-direction: column;
        }

        h3 {
          font-size: clamp(var(--fs-16), 2vw + 0.25rem, var(--fs-18));
        }

        p {
          margin-top: 0.5rem;
        }

        svg {
          padding: 0.6rem;
          background: #e7e8e9d8;
          border-radius: 4px;
          max-width: 2.5rem;
          min-width: 2.25rem;
        }
      }
    }
  }

  .cleaning-text-container {
