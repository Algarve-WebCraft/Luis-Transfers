---
import BaseLayout from "@layouts/BaseLayout.astro";
import { Image } from "astro:assets";
import cleaningImageOne from "@assets/images/cleaning-1.webp";
import cleaningImageTwo from "@assets/images/cleaning-2.jpeg";

const pageTitle = "Limpeza | Luis Ferreira Transferências e Serviços";
const pageDescription = "Page Description";
---

<BaseLayout pageTitle={pageTitle} pageDescription={pageDescription} bodyClass="secondary-page">
  <section class="cmp-hero-section" aria-labelledby="hero-section">
    <div class="wrapper wrapper--mobile-m">
      <div class="hero-text-container">
        <div class="hero-text__flex">
          <div>
            <div>
              <span class="cmp-topper-heading">CARVOEIRO • LAGOA • ALGARVE</span>
              <h1 id="hero-section" class="cmp-hero-heading">
                Serviços de Limpeza de Vilas e Apartamentos
              </h1>
            </div>

            <div>
              <p class="cmp-main-text">
                Cuidado rigoroso, higienização de qualidade e flexibilidade para proprietários particulares e
                alojamentos de férias no concelho de Lagoa e Carvoeiro.
              </p>
            </div>
          </div>

          <div class="hero-text-aside">
            <span class="cmp-topper-heading">
              <svg viewBox="0 0 19 18">
                <path
                  d="M6.33333 17.5L4.75 14.8333L1.75 14.1667L2.04167 11.0833L0 8.75L2.04167 6.41667L1.75 3.33333L4.75 2.66667L6.33333 0L9.16667 1.20833L12 0L13.5833 2.66667L16.5833 3.33333L16.2917 6.41667L18.3333 8.75L16.2917 11.0833L16.5833 14.1667L13.5833 14.8333L12 17.5L9.16667 16.2917L6.33333 17.5ZM7.04167 15.375L9.16667 14.4583L11.3333 15.375L12.5 13.375L14.7917 12.8333L14.5833 10.5L16.125 8.75L14.5833 6.95833L14.7917 4.625L12.5 4.125L11.2917 2.125L9.16667 3.04167L7 2.125L5.83333 4.125L3.54167 4.625L3.75 6.95833L2.20833 8.75L3.75 10.5L3.54167 12.875L5.83333 13.375L7.04167 15.375ZM8.29167 11.7083L13 7L11.8333 5.79167L8.29167 9.33333L6.5 7.58333L5.33333 8.75L8.29167 11.7083Z"
                  fill="#7A582F"
                />
              </svg>
              ALOJAMENTO LOCAL • AL
            </span>

            <p class="cmp-body-mini-text">
              Protocolos preparados para exigências de plataformas como Airbnb, VRBO e Booking.com.
            </p>
          </div>
        </div>

        <div class="hero__image-container">
          <div class="image-card">
            <Image
              src={cleaningImageOne}
              alt="Example of a cleaned summer Villa"
              width={[1200]}
              format="webp"
              layout="constrained"
            />

            <div class="image-card__content">
              <span class="cmp-topper-heading">Limpeza de Villas</span>
              <p>Deixe o seu apartamento impecável, fresco e pronto a desfrutar.</p>
            </div>
          </div>

          <div class="image-card">
            <Image
              src={cleaningImageTwo}
              alt="Example of a cleaned summer apartment"
              width={[1200]}
              format="webp"
              layout="constrained"
            />

            <div class="image-card__content">
              <span class="cmp-topper-heading">Limpeza de Apartamentos</span>
              <p>Cuidamos de cada espaço com atenção ao detalhe.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="cmp-main-section" aria-labelledby="cleaning-table-section">
    <div class="wrapper wrapper--tablet-48">
      <div class="cleaning-table__text-container">
        <span class="cmp-topper-heading">TABELA DE VALORES OFICIAIS</span>
        <h2 id="cleaning-table-section" class="cmp-main-heading">
          Tarifas Transparentes & Sem Surpresas
        </h2>
        <p class="cmp-body-text">
          Preçário direto para intervenções pontuais ou rotações periódicas entre check- outs. Sem taxas ocultas nem
          burocracias contratuais.
        </p>
      </div>

      <div class="cleaning-table__content-container">
        <div class="cleaning-card">
          <div class="card-headings-svg">
            <div class="card-heading">
              <span class="cmp-topper-heading">ALOJAMENTO FAMILIAR</span>
              <h3>Moradias (Villas)</h3>
              <p class="cmp-body-text">
                Dedicado a vivendas, moradias de luxo e quintas com amplas áreas interiores e exteriores, incluindo
                terraços e jardins, com atenção especial ao detalhe e às necessidades específicas de cada propriedade.
              </p>
            </div>

            <svg viewBox="0 0 21 21">
              <path
                d="M0 21V5.83333L15.1667 0V10.5H16.3333C16.3333 9.85833 16.5618 9.30903 17.0187 8.85208C17.4757 8.39514 18.025 8.16667 18.6667 8.16667C19.3083 8.16667 19.8576 8.39514 20.3146 8.85208C20.7715 9.30903 21 9.85833 21 10.5V21H0ZM2.33333 18.6667H4.66667H7V10.5H12.8333V8.16667V3.38333L2.33333 7.4375V18.6667ZM9.33333 18.6667H12.8333V15.1667H15.1667V18.6667H18.6667V12.8333H9.33333V18.6667Z"
                fill="black"
              />
            </svg>
          </div>

          <div class="card-flex">
            <div class="card-text">
              <span class="cmp-small-heading">Limpeza Intermédia</span>
              <p>
                Ideal para manutenção ligeira durante estadias prolongadas, refrescamento semanal ou preparação pré-
                visita.
              </p>
              <ul>
                <li>
                  <svg viewBox="0 0 11 8">
                    <path
                      d="M3.5625 7.51562L0 3.95312L0.890625 3.0625L3.5625 5.73438L9.29688 0L10.1875 0.890625L3.5625 7.51562Z"
                      fill="#7A582F"
                    />
                  </svg>

                  <span>Aspiração integral & desinfeção de pavimentos frios</span>
                </li>

                <li>
                  <svg viewBox="0 0 11 8">
                    <path
                      d="M3.5625 7.51562L0 3.95312L0.890625 3.0625L3.5625 5.73438L9.29688 0L10.1875 0.890625L3.5625 7.51562Z"
                      fill="#7A582F"
                    />
                  </svg>

                  <span>Higienização de bancadas, eletrodomésticos essenciais e loiças sanitárias</span>
                </li>

                <li>
                  <svg viewBox="0 0 11 8">
                    <path
                      d="M3.5625 7.51562L0 3.95312L0.890625 3.0625L3.5625 5.73438L9.29688 0L10.1875 0.890625L3.5625 7.51562Z"
                      fill="#7A582F"
                    />
                  </svg>

                  <span>Recolha de lixos e arejamento estruturado da casa</span>
                </li>
              </ul>
            </div>

            <div class="card-price">
              <span>€99</span>
              <span>~2 horas</span>
            </div>
          </div>

          <div class="card-flex">
            <div class="card-text">
              <span class="cmp-small-heading">Limpeza Completa (Full Service)</span>
              <p>
                Higienização minuciosa de todas as divisões: sanitização profunda de quartos, cozinhas, casas de banho e
                áreas sociais comuns.
              </p>
              <ul>
                <li>
                  <svg viewBox="0 0 11 8">
                    <path
                      d="M3.5625 7.51562L0 3.95312L0.890625 3.0625L3.5625 5.73438L9.29688 0L10.1875 0.890625L3.5625 7.51562Z"
                      fill="#7A582F"
                    />
                  </svg>

                  <span>Descalcificação completa de cabines de duche e torneiras</span>
                </li>

                <li>
                  <svg viewBox="0 0 11 8">
                    <path
                      d="M3.5625 7.51562L0 3.95312L0.890625 3.0625L3.5625 5.73438L9.29688 0L10.1875 0.890625L3.5625 7.51562Z"
                      fill="#7A582F"
                    />
                  </svg>

                  <span>Limpeza minuciosa de vidros e caixilharia interior/exterior</span>
                </li>

                <li>
                  <svg viewBox="0 0 11 8">
                    <path
                      d="M3.5625 7.51562L0 3.95312L0.890625 3.0625L3.5625 5.73438L9.29688 0L10.1875 0.890625L3.5625 7.51562Z"
                      fill="#7A582F"
                    />
                  </svg>

                  <span>Limpeza profunda de forno, exaustor, frigorífico e mobiliário de jardim</span>
                </li>

                <li>
                  <svg viewBox="0 0 11 8">
                    <path
                      d="M3.5625 7.51562L0 3.95312L0.890625 3.0625L3.5625 5.73438L9.29688 0L10.1875 0.890625L3.5625 7.51562Z"
                      fill="#7A582F"
                    />
                  </svg>

                  <span>Reposição criteriosa de consumíveis e conferência de apresentação</span>
                </li>
              </ul>
            </div>

            <div class="card-price">
              <span>€199</span>
              <span>~4 horas</span>
            </div>
          </div>

          <a
            href="https://wa.me/351966831360"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Contact us on WhatsApp"
          >
            <svg viewBox="0 0 11 11">
              <path d="M8.11667 6H0V4.66667H8.11667L4.38333 0.933333L5.33333 0L10.6667 5.33333L5.33333 10.6667L4.38333 9.73333L8.11667 6Z" />
            </svg>
            Reservar limpeza de vivenda
          </a>
        </div>

        <div class="cleaning-card">
          <div class="card-headings-svg">
            <div class="card-heading">
              <span class="cmp-topper-heading">ALOJAMENTO URBANO & PRAIAS</span>
              <h3>Apartamentos</h3>
              <p class="cmp-body-text">
                Desenvolvido à medida de estúdios, T1, T2 e coberturas urbanas, ideal para limpezas regulares ou entre
                estadias, com rotações rápidas de hóspedes, atenção ao detalhe e cumprimento rigoroso dos prazos.
              </p>
            </div>

            <svg viewBox="0 0 21 21">
              <path
                d="M0 21V4.66667H4.66667V0H16.3333V9.33333H21V21H11.6667V16.3333H9.33333V21H0ZM2.33333 18.6667H4.66667V16.3333H2.33333V18.6667ZM2.33333 14H4.66667V11.6667H2.33333V14ZM2.33333 9.33333H4.66667V7H2.33333V9.33333ZM7 14H9.33333V11.6667H7V14ZM7 9.33333H9.33333V7H7V9.33333ZM7 4.66667H9.33333V2.33333H7V4.66667ZM11.6667 14H14V11.6667H11.6667V14ZM11.6667 9.33333H14V7H11.6667V9.33333ZM11.6667 4.66667H14V2.33333H11.6667V4.66667ZM16.3333 18.6667H18.6667V16.3333H16.3333V18.6667ZM16.3333 14H18.6667V11.6667H16.3333V14Z"
                fill="black"
              />
            </svg>
          </div>

          <div class="card-flex">
            <div class="card-text">
              <span class="cmp-small-heading">Limpeza Intermédia</span>
              <p>
                Manutenção periódica rápida e eficaz de pavimentos, superfícies e sanitários entre reservas de curta
                permanência.
              </p>
              <ul>
                <li>
                  <svg viewBox="0 0 11 8">
                    <path
                      d="M3.5625 7.51562L0 3.95312L0.890625 3.0625L3.5625 5.73438L9.29688 0L10.1875 0.890625L3.5625 7.51562Z"
                      fill="#7A582F"
                    />
                  </svg>

                  <span>Higienização express de cozinha e casa de banho</span>
                </li>

                <li>
                  <svg viewBox="0 0 11 8">
                    <path
                      d="M3.5625 7.51562L0 3.95312L0.890625 3.0625L3.5625 5.73438L9.29688 0L10.1875 0.890625L3.5625 7.51562Z"
                      fill="#7A582F"
                    />
                  </svg>

                  <span>Remoção de poeiras de superfícies e pavimentos aspirados</span>
                </li>

                <li>
                  <svg viewBox="0 0 11 8">
                    <path
                      d="M3.5625 7.51562L0 3.95312L0.890625 3.0625L3.5625 5.73438L9.29688 0L10.1875 0.890625L3.5625 7.51562Z"
                      fill="#7A582F"
                    />
                  </svg>

                  <span>Troca rápida de sacos e reposição estética</span>
                </li>
              </ul>
            </div>

            <div class="card-price">
              <span>€59</span>
              <span>~1h 15 min</span>
            </div>
          </div>

          <div class="card-flex">
            <div class="card-text">
              <span class="cmp-small-heading">Limpeza Completa (Full Service)</span>
              <p>
                Limpeza total pormenorizada de todo o espaço. Inclui tratamento de lavandaria (roupas de cama e toalhas
                prontas a usar).
              </p>
              <ul>
                <li>
                  <svg viewBox="0 0 11 8">
                    <path
                      d="M3.5625 7.51562L0 3.95312L0.890625 3.0625L3.5625 5.73438L9.29688 0L10.1875 0.890625L3.5625 7.51562Z"
                      fill="#7A582F"
                    />
                  </svg>

                  <span>Desinfeção aprofundada de todas as divisões e terraço/varanda</span>
                </li>

                <li>
                  <svg viewBox="0 0 11 8">
                    <path
                      d="M3.5625 7.51562L0 3.95312L0.890625 3.0625L3.5625 5.73438L9.29688 0L10.1875 0.890625L3.5625 7.51562Z"
                      fill="#7A582F"
                    />
                  </svg>

                  <span>Gestão completa de lavandaria (roupa de cama e conjunto de banho)</span>
                </li>

                <li>
                  <svg viewBox="0 0 11 8">
                    <path
                      d="M3.5625 7.51562L0 3.95312L0.890625 3.0625L3.5625 5.73438L9.29688 0L10.1875 0.890625L3.5625 7.51562Z"
                      fill="#7A582F"
                    />
                  </svg>

                  <span>Engomadoria profissional e montagem impecável de camas</span>
                </li>

                <li>
                  <svg viewBox="0 0 11 8">
                    <path
                      d="M3.5625 7.51562L0 3.95312L0.890625 3.0625L3.5625 5.73438L9.29688 0L10.1875 0.890625L3.5625 7.51562Z"
                      fill="#7A582F"
                    />
                  </svg>

                  <span>Verificação de electrodomésticos para os próximos hóspedes</span>
                </li>
              </ul>
            </div>

            <div class="card-price">
              <span>€119</span>
              <span>~2h 30 min</span>
            </div>
          </div>

          <a
            href="https://wa.me/351966831360"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Contact us on WhatsApp"
          >
            <svg viewBox="0 0 11 11">
              <path d="M8.11667 6H0V4.66667H8.11667L4.38333 0.933333L5.33333 0L10.6667 5.33333L5.33333 10.6667L4.38333 9.73333L8.11667 6Z" />
            </svg>
            Reservar limpeza de apartamento
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="cmp-main-section" aria-labelledby="guarantee-section">
    <div class="wrapper wrapper--mobile-32 wrapper--tablet-48">
      <div class="guarantee-text-container">
        <div>
          <div>
            <span class="cmp-topper-heading">GARANTIA & CRITÉRIO</span>
            <h2 id="guarantee-section" class="cmp-main-heading">
              O Nosso Compromisso de Limpeza
            </h2>
          </div>

          <div>
            <p class="cmp-body-text">
              Focamo-nos exclusivamente no rigor da higienização para que cada hóspede entre num ambiente
              irrepreensível, como se estreasse a casa.
            </p>
          </div>
        </div>
      </div>

      <div class="guarantee-card-container">
        <div class="gaurantee-card">
          <svg viewBox="0 0 21 14">
            <path
              d="M0 13.75V0H1.83333V9.16667H9.16667V1.83333H16.5C17.5083 1.83333 18.3715 2.19236 19.0896 2.91042C19.8076 3.62847 20.1667 4.49167 20.1667 5.5V13.75H18.3333V11H1.83333V13.75H0ZM5.5 8.25C4.73611 8.25 4.08681 7.98264 3.55208 7.44792C3.01736 6.91319 2.75 6.26389 2.75 5.5C2.75 4.73611 3.01736 4.08681 3.55208 3.55208C4.08681 3.01736 4.73611 2.75 5.5 2.75C6.26389 2.75 6.91319 3.01736 7.44792 3.55208C7.98264 4.08681 8.25 4.73611 8.25 5.5C8.25 6.26389 7.98264 6.91319 7.44792 7.44792C6.91319 7.98264 6.26389 8.25 5.5 8.25ZM11 9.16667H18.3333V5.5C18.3333 4.99583 18.1538 4.56424 17.7948 4.20521C17.4358 3.84618 17.0042 3.66667 16.5 3.66667H11V9.16667ZM5.5 6.41667C5.75972 6.41667 5.97743 6.32882 6.15312 6.15312C6.32882 5.97743 6.41667 5.75972 6.41667 5.5C6.41667 5.24028 6.32882 5.02257 6.15312 4.84688C5.97743 4.67118 5.75972 4.58333 5.5 4.58333C5.24028 4.58333 5.02257 4.67118 4.84688 4.84688C4.67118 5.02257 4.58333 5.24028 4.58333 5.5C4.58333 5.75972 4.67118 5.97743 4.84688 6.15312C5.02257 6.32882 5.24028 6.41667 5.5 6.41667ZM11 3.66667V9.16667V3.66667Z"
              fill="black"
            />
          </svg>

          <h3 class="cmp-small-heading">Padrão Hoteleiro</h3>
          <p class="cmp-body-mini-text">
            Metodologia ajustada aos mais altos critérios de avaliação do Airbnb Superhost e Booking.com.
          </p>
        </div>

        <div class="gaurantee-card">
          <svg viewBox="0 0 16 16">
            <path
              d="M2.2 13.3763C1.5125 12.6888 0.973958 11.8943 0.584375 10.9929C0.194792 10.0916 0 9.15961 0 8.19711C0 7.23461 0.183333 6.28357 0.55 5.34399C0.916667 4.40441 1.5125 3.52212 2.3375 2.69712C2.87222 2.16239 3.53299 1.70406 4.31979 1.32212C5.1066 0.940171 6.03854 0.638435 7.11562 0.416907C8.19271 0.195379 9.42257 0.0616987 10.8052 0.0158654C12.1878 -0.0299679 13.7347 0.0235043 15.4458 0.176282C15.5681 1.79573 15.6062 3.28531 15.5604 4.64503C15.5146 6.00475 15.3885 7.2308 15.1823 8.32316C14.976 9.41552 14.6858 10.3704 14.3115 11.1877C13.9372 12.0051 13.475 12.6888 12.925 13.2388C12.1153 14.0485 11.2559 14.6405 10.3469 15.0148C9.43785 15.3891 8.50972 15.5763 7.5625 15.5763C6.56944 15.5763 5.59931 15.3815 4.65208 14.9919C3.70486 14.6023 2.8875 14.0638 2.2 13.3763ZM4.76667 13.0096C5.20972 13.2693 5.66424 13.4565 6.13021 13.5711C6.59618 13.6857 7.07361 13.7429 7.5625 13.7429C8.26528 13.7429 8.96042 13.6016 9.64792 13.319C10.3354 13.0364 10.9924 12.5818 11.6187 11.9554C11.8937 11.6804 12.1726 11.2947 12.4552 10.7982C12.7378 10.3016 12.9823 9.65232 13.1885 8.85024C13.3948 8.04816 13.5514 7.07802 13.6583 5.93982C13.7653 4.80163 13.7806 3.44573 13.7042 1.87212C12.9556 1.84156 12.1115 1.8301 11.1719 1.83774C10.2323 1.84538 9.29653 1.91795 8.36458 2.05545C7.43264 2.19295 6.54653 2.41448 5.70625 2.72003C4.86597 3.02559 4.17847 3.44573 3.64375 3.98045C2.95625 4.66795 2.48264 5.34781 2.22292 6.02003C1.96319 6.69225 1.83333 7.34156 1.83333 7.96795C1.83333 8.86934 2.00521 9.65996 2.34896 10.3398C2.69271 11.0197 2.99444 11.4971 3.25417 11.7721C3.89583 10.5499 4.74375 9.37732 5.79792 8.25441C6.85208 7.13149 8.08194 6.211 9.4875 5.49295C8.3875 6.45545 7.42882 7.54399 6.61146 8.75857C5.7941 9.97316 5.17917 11.3902 4.76667 13.0096Z"
              fill="black"
            />
          </svg>

          <h3 class="cmp-small-heading">Produtos Profissionais</h3>
          <p class="cmp-body-mini-text">
            Utilização de produtos de grau profissional e ecológicos, que desinfetam eficazmente sem danificar materiais
            nobres.
          </p>
        </div>

        <div class="gaurantee-card">
