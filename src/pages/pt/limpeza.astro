          width: 1rem;
          min-width: 1rem;
          margin-right: 0.35rem;
          top: 0.2rem;
        }
      }
    }

    .hero__image-container {
      display: flex;
      gap: 1rem;
      margin-top: 3rem;

      @media (width > 62.5rem) {
        gap: 1.5rem;
      }

      .image-card {
        display: grid;
        grid-template: 1fr / 1fr;
        overflow: hidden;

        > * {
          grid-area: 1 / 1;
        }

        img {
          aspect-ratio: 1.75 / 1;
          border-radius: 4px;
          transition: transform 0.75s ease-out;

          @media (width > 62.5rem) {
            aspect-ratio: 2.3 / 1;
          }

          &:hover {
            transform: scale(1.05);
          }
        }

        &:last-child {
          display: none;

          @media (width > 47.5rem) {
            display: grid;
            max-width: 30%;
          }

          img {
            @media (width > 47.5rem) {
              display: block;
              aspect-ratio: 0.75 / 1;
            }

            @media (width > 62.5rem) {
              aspect-ratio: 1 / 1;
            }
          }
        }

        .image-card__content {
          position: relative;
          align-self: end;
          padding: 1.5rem;
          color: var(--clr-white-10);
          z-index: 999;
          background: linear-gradient(transparent, rgb(0 0 0 / 95%));

          span {
            color: var(--clr-beige-10);
          }

          p {
            font-family: var(--ff-news);
            font-weight: var(--fw-regular);
            letter-spacing: var(--ls-pos-015);
          }
        }
      }
    }
