      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero__text-container {
    @media (width > 47.5rem) {
      text-align: center;
    }

    p {
      max-width: 50ch;

      @media (width > 47.5rem) {
        max-width: 55ch;
        margin-inline: auto;
      }
    }

    .hero-bottom-container {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1rem;
      row-gap: 2rem;
      position: relative;
      font-size: var(--fs-13);
      color: var(--clr-black-40);
      margin-bottom: 4rem;
      margin-top: 3rem;
      line-height: var(--lh-155);

      @media (width > 62.5rem) {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 4rem;
        white-space: nowrap;
      }

      &::after {
        content: "";
        position: absolute;
        display: block;
        top: 140%;
        width: 100%;
        height: 1px;
        background-color: var(--clr-black-40);
        opacity: 0.1;

        @media (width > 47.5rem) {
          top: 7rem;
        }

        @media (width > 62.5rem) {
          top: 5.5rem;
        }
      }

      > span {
        display: flex;
        align-items: center;

        @media (width > 47.5rem) {
          display: block;
        }
      }

      svg {
        position: relative;
        max-width: 1rem;
        margin-right: 0.5rem;
      }
    }
  }

  .transfer-section-container {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 3rem;

    @media (width > 62.5rem) {
      flex-direction: row;
      margin-bottom: 2rem;
    }

    .transfer-form-container {
      width: 100%;
      padding: 1.5rem;
      background: rgba(255, 255, 255, 0);
      margin-top: -5rem;
      border-radius: 8px;
      box-shadow: var(--box-shadow-10);

      @media (width > 62.5rem) {
        max-width: 62%;
        margin-top: unset;
        padding: 3rem;
      }

      a,
      button {
        max-width: 35ch;
      }
    }

    .transfer-side-container {
      display: grid;
      grid-template-columns: 1fr;
      place-items: center;
      gap: 1rem;

      h2 {
        margin-bottom: 0.5rem;
      }

      @media (width > 47.5rem) {
        grid-template-columns: 1fr 1fr;
      }

      @media (width > 62.5rem) {
        display: flex;
        flex-direction: column;
      }

      .side-container-block {
        width: 100%;
        max-width: 26rem;
        align-self: end;
        padding: 1.5em 1em;
        border-radius: 8px;
        box-shadow: var(--box-shadow-10);
        transition: transform 0.3s ease-out;

        span:last-of-type {
          display: inline-block;
          font-size: var(--fs-22);
          font-family: var(--ff-news);
          font-weight: var(--fw-semibold);
          line-height: var(--lh-125);
          letter-spacing: var(--ls-pos-5);
          margin-top: 2rem;
        }

        &:last-child {
          background-color: var(--clr-black-20);

          h2,
          p {
            color: var(--clr-white-10);
          }

          p {
            opacity: 0.8;
          }

          span {
            color: var(--clr-beige-10);
          }
        }

        &:hover {
          transform: translateY(-0.2rem);
        }
      }
    }
  }

  .popular-routes-container {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 2rem;

    @media (width > 47.5rem) {
      flex-direction: row;
      margin-bottom: 5rem;
      gap: 4rem;
    }

    p {
      @media (width > 47.5rem) {
        max-width: 40%;
        align-self: end;
      }
    }
  }

  .location-container {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;

    @media (width > 47.5rem) {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }

