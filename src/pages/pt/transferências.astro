---
import BaseLayout from "@layouts/BaseLayout.astro";
import RoutesCards from "@components/other/RoutesCards.astro";
import TransferForm from "@components/other/TransferForm.astro";
import RoutesCardsTransfers from "@components/other/RoutesCardsTransfers.astro";

const { locale } = Astro.props;

const pageTitle = "Transferências | Luis Ferreira Transferências e Serviços";
const pageDescription = "Page Description";
---

<BaseLayout pageTitle={pageTitle} pageDescription={pageDescription} bodyClass="secondary-page">
  <section class="cmp-hero-section" aria-labelledby="hero-section">
    <div class="wrapper wrapper--tablet-48">
      <div class="hero__text-container">
        <span class="cmp-topper-heading">•&nbsp; Serviço oficial de transfers &nbsp;•&nbsp; RNAVT N.º 11744</span>
        <h1 id="hero-section" class="cmp-hero-heading">
          Transfers Privados & Executivos
        </h1>
        <p class="cmp-main-text">
          Reserve o seu transfer no Algarve com motorista dedicado, conforto irrepreensível, serviço personalizado e
          pontualidade rigorosa.
        </p>

        <div class="hero-bottom-container">
          <span>
            <svg viewBox="0 0 17 12">
              <path
                d="M9.75 6.75C9.125 6.75 8.59375 6.53125 8.15625 6.09375C7.71875 5.65625 7.5 5.125 7.5 4.5C7.5 3.875 7.71875 3.34375 8.15625 2.90625C8.59375 2.46875 9.125 2.25 9.75 2.25C10.375 2.25 10.9062 2.46875 11.3438 2.90625C11.7812 3.34375 12 3.875 12 4.5C12 5.125 11.7812 5.65625 11.3438 6.09375C10.9062 6.53125 10.375 6.75 9.75 6.75ZM4.5 9C4.0875 9 3.73438 8.85312 3.44062 8.55937C3.14687 8.26562 3 7.9125 3 7.5V1.5C3 1.0875 3.14687 0.734375 3.44062 0.440625C3.73438 0.146875 4.0875 0 4.5 0H15C15.4125 0 15.7656 0.146875 16.0594 0.440625C16.3531 0.734375 16.5 1.0875 16.5 1.5V7.5C16.5 7.9125 16.3531 8.26562 16.0594 8.55937C15.7656 8.85312 15.4125 9 15 9H4.5ZM6 7.5H13.5C13.5 7.0875 13.6469 6.73438 13.9406 6.44063C14.2344 6.14688 14.5875 6 15 6V3C14.5875 3 14.2344 2.85313 13.9406 2.55938C13.6469 2.26562 13.5 1.9125 13.5 1.5H6C6 1.9125 5.85312 2.26562 5.55937 2.55938C5.26562 2.85313 4.9125 3 4.5 3V6C4.9125 6 5.26562 6.14688 5.55937 6.44063C5.85312 6.73438 6 7.0875 6 7.5ZM14.25 12H1.5C1.0875 12 0.734375 11.8531 0.440625 11.5594C0.146875 11.2656 0 10.9125 0 10.5V2.25H1.5V10.5H14.25V12ZM4.5 7.5V1.5V7.5Z"
                fill="#7A582F"
              />
            </svg>
            <span>Pagamento Direto ao Motorista</span>
          </span>

          <span>
            <svg viewBox="0 0 15 15">
              <path
                d="M3.75 15V13.125L6 11.55V8.85L0 11.25V9L6 4.8V1.5C6 1.0875 6.14688 0.734375 6.44063 0.440625C6.73438 0.146875 7.0875 0 7.5 0C7.9125 0 8.26562 0.146875 8.55937 0.440625C8.85312 0.734375 9 1.0875 9 1.5V4.8L15 9V11.25L9 8.85V11.55L11.25 13.125V15L7.5 13.875L3.75 15Z"
                fill="#7A582F"
              />
            </svg>
            <span>Meet & Greet no Aeroporto</span>
          </span>

          <span>
            <svg viewBox="0 0 15 15">
              <path
                d="M4.875 15C4.55 15 4.28125 14.8937 4.06875 14.6812C3.85625 14.4688 3.75 14.2 3.75 13.875C3.75 13.55 3.85625 13.2812 4.06875 13.0688C4.28125 12.8563 4.55 12.75 4.875 12.75C5.2 12.75 5.46875 12.8563 5.68125 13.0688C5.89375 13.2812 6 13.55 6 13.875C6 14.2 5.89375 14.4688 5.68125 14.6812C5.46875 14.8937 5.2 15 4.875 15ZM13.125 15C12.8 15 12.5312 14.8937 12.3188 14.6812C12.1063 14.4688 12 14.2 12 13.875C12 13.55 12.1063 13.2812 12.3188 13.0688C12.5312 12.8563 12.8 12.75 13.125 12.75C13.45 12.75 13.7188 12.8563 13.9312 13.0688C14.1437 13.2812 14.25 13.55 14.25 13.875C14.25 14.2 14.1437 14.4688 13.9312 14.6812C13.7188 14.8937 13.45 15 13.125 15ZM8.625 4.2L5.7 0.675C6.15 0.45 6.6375 0.28125 7.1625 0.16875C7.6875 0.05625 8.25 0 8.85 0C9.4875 0 10.0969 0.090625 10.6781 0.271875C11.2594 0.453125 11.775 0.7125 12.225 1.05L8.625 4.2ZM7.5 12C6.4625 12 5.57812 11.6344 4.84688 10.9031C4.11563 10.1719 3.75 9.2875 3.75 8.25V2.475L3.375 2.025C3.2 1.8125 3.05313 1.67188 2.93438 1.60312C2.81562 1.53437 2.6875 1.5 2.55 1.5C2.25 1.5 2 1.6125 1.8 1.8375C1.6 2.0625 1.5 2.325 1.5 2.625H0C0 1.9125 0.246875 1.29688 0.740625 0.778125C1.23438 0.259375 1.8375 0 2.55 0C2.925 0 3.26875 0.0875 3.58125 0.2625C3.89375 0.4375 4.2125 0.7125 4.5375 1.0875L12.5625 10.7625C12.775 11.0125 12.8156 11.2812 12.6844 11.5688C12.5531 11.8563 12.325 12 12 12H7.5ZM7.5 10.5H10.3875L5.25 4.275V8.25C5.25 8.875 5.46875 9.40625 5.90625 9.84375C6.34375 10.2812 6.875 10.5 7.5 10.5Z"
                fill="#7A582F"
              />
            </svg>
            <span>Cadeiras de Bebé</span>
          </span>

          <span>
            <svg viewBox="0 0 15 15">
              <path
                d="M9.4125 10.9125L6.75 8.25V4.5H8.25V7.63125L10.4625 9.84375L9.4125 10.9125ZM6.75 3V1.5H8.25V3H6.75ZM12 8.25V6.75H13.5V8.25H12ZM6.75 13.5V12H8.25V13.5H6.75ZM1.5 8.25V6.75H3V8.25H1.5ZM7.5 15C6.4625 15 5.4875 14.8031 4.575 14.4094C3.6625 14.0156 2.86875 13.4812 2.19375 12.8062C1.51875 12.1312 0.984375 11.3375 0.590625 10.425C0.196875 9.5125 0 8.5375 0 7.5C0 6.4625 0.196875 5.4875 0.590625 4.575C0.984375 3.6625 1.51875 2.86875 2.19375 2.19375C2.86875 1.51875 3.6625 0.984375 4.575 0.590625C5.4875 0.196875 6.4625 0 7.5 0C8.5375 0 9.5125 0.196875 10.425 0.590625C11.3375 0.984375 12.1312 1.51875 12.8062 2.19375C13.4812 2.86875 14.0156 3.6625 14.4094 4.575C14.8031 5.4875 15 6.4625 15 7.5C15 8.5375 14.8031 9.5125 14.4094 10.425C14.0156 11.3375 13.4812 12.1312 12.8062 12.8062C12.1312 13.4812 11.3375 14.0156 10.425 14.4094C9.5125 14.8031 8.5375 15 7.5 15ZM7.5 13.5C9.175 13.5 10.5938 12.9188 11.7563 11.7563C12.9188 10.5938 13.5 9.175 13.5 7.5C13.5 5.825 12.9188 4.40625 11.7563 3.24375C10.5938 2.08125 9.175 1.5 7.5 1.5C5.825 1.5 4.40625 2.08125 3.24375 3.24375C2.08125 4.40625 1.5 5.825 1.5 7.5C1.5 9.175 2.08125 10.5938 3.24375 11.7563C4.40625 12.9188 5.825 13.5 7.5 13.5Z"
                fill="#7A582F"
              />
            </svg>
            <span>Sem Custos por Atrasos</span>
          </span>
        </div>
      </div>
    </div>
  </section>

  <section class="cmp-main-section" aria-labelledby="transfer-section">
    <div class="wrapper wrapper--mobile-40 wrapper--tablet-48">
      <div class="transfer-section-container">
        <div class="transfer-form-container">
          <span class="cmp-topper-heading">RESPOSTA RÁPIDA • RESERVA SIMPLES</span>
          <h2 id="transfer-section" class="cmp-main-heading">
            Solicitar Transfer Executivo
          </h2>

          <TransferForm locale={locale} layout="compact" />
          <p id="status" aria-live="polite"></p>
        </div>

        <div class="transfer-side-container">
          <div class="side-container-block">
            <span class="cmp-topper-heading">ESTACIONAMENTO</span>
            <h2 class="cmp-small-heading">Terminal Aeroporto Faro</h2>
            <p class="cmp-body-mini-text">
              Acesso exclusivo à área VIP de chegadas do terminal, garantindo uma recolha de passageiros mais cómoda,
              direta e personalizada.
            </p>
            <span>+ €7,00</span>
          </div>

          <div class="side-container-block">
            <span class="cmp-topper-heading">PERÍODO NOTURNO</span>
            <h2 class="cmp-small-heading">Horário 22h00 — 06h00</h2>
            <p class="cmp-body-mini-text">
              Pontualidade garantida e assistência noturna exclusiva, com total disponibilidade e acompanhamento
              personalizado para viagens a qualquer hora do dia ou da noite.
            </p>
            <span>+ €10,00</span>
          </div>

          <div class="side-container-block">
            <span class="cmp-topper-heading">MADRUGADA</span>
            <h2 class="cmp-small-heading">Horário 00h00 — 04h00</h2>
            <p class="cmp-body-mini-text">
              Disponibilidade dedicada 24 horas por dia, com acompanhamento personalizado e assistência em chegadas
              tardias, garantindo uma viagem tranquila a qualquer hora.
            </p>
            <span>+ €15,00</span>
          </div>

          <div class="side-container-block">
            <span class="cmp-topper-heading">LONGA DISTÂNCIA</span>
            <h2 class="cmp-small-heading">Lisboa / Sevilha</h2>
            <p class="cmp-body-mini-text">
              Viagens de longa distância para os aeroportos de Lisboa e Sevilha, com portagens incluídas e máximo
              conforto durante todo o percurso.
            </p>
            <span>A partir de €220</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="cmp-main-section" aria-labelledby="popular-routes-section">
    <div class="wrapper wrapper--mobile-40">
      <div class="popular-routes-container">
        <div class="popular-routes__text">
          <span class="cmp-topper-heading">TABELA TRANSPARENTE</span>
          <h2 id="popular-routes-section" class="cmp-main-heading">
            13 Destinos Populares a partir de Faro
          </h2>
        </div>

        <p class="cmp-body-text">
          Valores fixos até 4 passageiros com bagagem. Selecione qualquer rota para carregar de imediato no formulário
          de reserva acima.
        </p>
      </div>

      <RoutesCardsTransfers />
    </div>
  </section>

  <section class="cmp-main-section" aria-labelledby="location-section">
    <div class="wrapper wrapper--mobile-32">
      <div class="location-container">
        <div class="location__text">
          <span class="cmp-topper-heading">LOCALIZAÇÃO CENTRAL</span>
          <h2 id="location-section" class="cmp-main-heading">
            Sediados em Carvoeiro, Conectados a Todo o Algarve
          </h2>
          <p class="cmp-body-text">
            Com base estratégica em Carvoeiro (Lagoa), garantimos tempos de resposta ultrarrápidos para recolhas em
            Ferragudo, Alvor, Portimão e chegadas ao Aeroporto Internacional de Faro.
          </p>

          <div class="location__text__list">
            <span>
              <svg viewBox="0 0 17 17">
                <path
                  d="M7.16667 12.1667L13.0417 6.29167L11.875 5.125L7.16667 9.83333L4.79167 7.45833L3.625 8.625L7.16667 12.1667ZM8.33333 16.6667C7.18056 16.6667 6.09722 16.4479 5.08333 16.0104C4.06944 15.5729 3.1875 14.9792 2.4375 14.2292C1.6875 13.4792 1.09375 12.5972 0.65625 11.5833C0.21875 10.5694 0 9.48611 0 8.33333C0 7.18056 0.21875 6.09722 0.65625 5.08333C1.09375 4.06944 1.6875 3.1875 2.4375 2.4375C3.1875 1.6875 4.06944 1.09375 5.08333 0.65625C6.09722 0.21875 7.18056 0 8.33333 0C9.48611 0 10.5694 0.21875 11.5833 0.65625C12.5972 1.09375 13.4792 1.6875 14.2292 2.4375C14.9792 3.1875 15.5729 4.06944 16.0104 5.08333C16.4479 6.09722 16.6667 7.18056 16.6667 8.33333C16.6667 9.48611 16.4479 10.5694 16.0104 11.5833C15.5729 12.5972 14.9792 13.4792 14.2292 14.2292C13.4792 14.9792 12.5972 15.5729 11.5833 16.0104C10.5694 16.4479 9.48611 16.6667 8.33333 16.6667ZM8.33333 15C10.1944 15 11.7708 14.3542 13.0625 13.0625C14.3542 11.7708 15 10.1944 15 8.33333C15 6.47222 14.3542 4.89583 13.0625 3.60417C11.7708 2.3125 10.1944 1.66667 8.33333 1.66667C6.47222 1.66667 4.89583 2.3125 3.60417 3.60417C2.3125 4.89583 1.66667 6.47222 1.66667 8.33333C1.66667 10.1944 2.3125 11.7708 3.60417 13.0625C4.89583 14.3542 6.47222 15 8.33333 15Z"
                  fill="#7A582F"
                />
              </svg>

              <p>Motoristas profissionais, com experiência e conhecimento da região do Algarve</p>
            </span>

            <span>
              <svg viewBox="0 0 17 17">
                <path
                  d="M7.16667 12.1667L13.0417 6.29167L11.875 5.125L7.16667 9.83333L4.79167 7.45833L3.625 8.625L7.16667 12.1667ZM8.33333 16.6667C7.18056 16.6667 6.09722 16.4479 5.08333 16.0104C4.06944 15.5729 3.1875 14.9792 2.4375 14.2292C1.6875 13.4792 1.09375 12.5972 0.65625 11.5833C0.21875 10.5694 0 9.48611 0 8.33333C0 7.18056 0.21875 6.09722 0.65625 5.08333C1.09375 4.06944 1.6875 3.1875 2.4375 2.4375C3.1875 1.6875 4.06944 1.09375 5.08333 0.65625C6.09722 0.21875 7.18056 0 8.33333 0C9.48611 0 10.5694 0.21875 11.5833 0.65625C12.5972 1.09375 13.4792 1.6875 14.2292 2.4375C14.9792 3.1875 15.5729 4.06944 16.0104 5.08333C16.4479 6.09722 16.6667 7.18056 16.6667 8.33333C16.6667 9.48611 16.4479 10.5694 16.0104 11.5833C15.5729 12.5972 14.9792 13.4792 14.2292 14.2292C13.4792 14.9792 12.5972 15.5729 11.5833 16.0104C10.5694 16.4479 9.48611 16.6667 8.33333 16.6667ZM8.33333 15C10.1944 15 11.7708 14.3542 13.0625 13.0625C14.3542 11.7708 15 10.1944 15 8.33333C15 6.47222 14.3542 4.89583 13.0625 3.60417C11.7708 2.3125 10.1944 1.66667 8.33333 1.66667C6.47222 1.66667 4.89583 2.3125 3.60417 3.60417C2.3125 4.89583 1.66667 6.47222 1.66667 8.33333C1.66667 10.1944 2.3125 11.7708 3.60417 13.0625C4.89583 14.3542 6.47222 15 8.33333 15Z"
                  fill="#7A582F"
                />
              </svg>

              <p>Acesso direto e descarregamento na porta da sua villa ou hotel</p>
            </span>

            <span>
              <svg viewBox="0 0 17 17">
                <path
                  d="M7.16667 12.1667L13.0417 6.29167L11.875 5.125L7.16667 9.83333L4.79167 7.45833L3.625 8.625L7.16667 12.1667ZM8.33333 16.6667C7.18056 16.6667 6.09722 16.4479 5.08333 16.0104C4.06944 15.5729 3.1875 14.9792 2.4375 14.2292C1.6875 13.4792 1.09375 12.5972 0.65625 11.5833C0.21875 10.5694 0 9.48611 0 8.33333C0 7.18056 0.21875 6.09722 0.65625 5.08333C1.09375 4.06944 1.6875 3.1875 2.4375 2.4375C3.1875 1.6875 4.06944 1.09375 5.08333 0.65625C6.09722 0.21875 7.18056 0 8.33333 0C9.48611 0 10.5694 0.21875 11.5833 0.65625C12.5972 1.09375 13.4792 1.6875 14.2292 2.4375C14.9792 3.1875 15.5729 4.06944 16.0104 5.08333C16.4479 6.09722 16.6667 7.18056 16.6667 8.33333C16.6667 9.48611 16.4479 10.5694 16.0104 11.5833C15.5729 12.5972 14.9792 13.4792 14.2292 14.2292C13.4792 14.9792 12.5972 15.5729 11.5833 16.0104C10.5694 16.4479 9.48611 16.6667 8.33333 16.6667ZM8.33333 15C10.1944 15 11.7708 14.3542 13.0625 13.0625C14.3542 11.7708 15 10.1944 15 8.33333C15 6.47222 14.3542 4.89583 13.0625 3.60417C11.7708 2.3125 10.1944 1.66667 8.33333 1.66667C6.47222 1.66667 4.89583 2.3125 3.60417 3.60417C2.3125 4.89583 1.66667 6.47222 1.66667 8.33333C1.66667 10.1944 2.3125 11.7708 3.60417 13.0625C4.89583 14.3542 6.47222 15 8.33333 15Z"
                  fill="#7A582F"
