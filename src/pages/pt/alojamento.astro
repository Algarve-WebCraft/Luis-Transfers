<style>
  .hero-container {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-bottom: 4rem;

    @media (width > 47.5rem) {
      flex-direction: row;
      align-items: flex-end;
      gap: 5rem;
    }

    .hero__text-container {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      justify-content: space-between;

      h1 {
        min-width: 15ch;
        max-width: 30ch;

        @media (width > 47.5rem) {
          max-width: unset;
        }
      }

      p {
        margin-bottom: 1rem;
        max-width: 50ch;
      }
    }

    .hero__btn-container {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 0.75rem;

      @media (width > 62.5rem) {
        flex-direction: row;
        gap: 1rem;
      }

      svg {
        max-width: 1rem;
        min-width: 1rem;
      }

      a {
        display: flex;
        gap: 0.75rem;
        width: 100%;
        max-width: fit-content;
        padding-block: 1em;
        font-size: var(--fs-14);
        white-space: nowrap;

        @media (width > 62.5rem) {
          padding-block: 1.5em;
        }
      }

      & a:last-of-type {
        font-weight: var(--fw-semibold);
        background-color: #edeeef;
        color: var(--clr-black-10);
        box-shadow:
          inset 0 1px 2px #ffffff3c,
          0 4px 10px #00000019;
        transition:
          transform 0.2s ease-in-out,
          box-shadow 0.2s ease-in-out;

        &:hover {
          transform: translateY(-1px);
          box-shadow:
            inset 0 1px 2px #ffffffa0,
            0 4px 10px #00000036;
        }
      }
    }
  }

  .image-span {
    font-size: var(--fs-13);
    letter-spacing: var(--ls-pos-1);
    text-decoration: underline;
    text-underline-offset: 0.2rem;

    @media (width > 43.75rem) {
      font-size: var(--fs-15);
    }
  }

  .hero-image-container {
    margin-top: 0.75rem;

    @media (width > 43.75rem) {
      display: grid;
      grid-template-columns: 2fr 1fr;
      gap: 1rem;
      column-gap: 2rem;
    }

    .hero-image {
      display: block;
      border-radius: 4px;
      overflow: hidden;
      box-shadow:
        0 6px 12px rgba(0, 0, 0, 0.4),
        0 4px 8px rgba(0, 0, 0, 0.2),
        0 0 0 1px rgba(255, 255, 255, 0.04);

      img {
        height: 100%;
        object-position: 100% 50%;
      }
    }

    .hero-image:first-child {
      aspect-ratio: 1.75 / 1;
      grid-column: 1 / 2;
      grid-row: 1 / 4;

      @media (width > 43.75rem) {
        aspect-ratio: 1.5 / 1;
      }
    }

    .hero-image:nth-child(2),
    .hero-image:nth-child(3),
    .hero-image:nth-child(4) {
      aspect-ratio: 2 / 1;
      grid-column: 2 / 3;
    }

    .hero-image:nth-child(2) {
      grid-row: 1 / 2;
    }

    .hero-image:nth-child(3) {
      grid-row: 2 / 3;
    }

    .hero-image:nth-child(4) {
      grid-row: 3 / 4;
    }

    .hero-image.desktop-only {
      display: none;

      @media (width > 43.75rem) {
        display: block;
      }
    }

    img {
      border-radius: 4px;
      transition: transform 0.75s ease-out;

      &:hover {
        transform: scale(1.05);
      }
    }
  }

  .details-container {
    .details__header-container {
      margin-bottom: 3.5rem;
      text-align: left;

      @media (width > 47.5rem) {
        text-align: center;
      }
    }

    h2 {
      max-width: 30ch;
      text-wrap: pretty;
      margin-inline: unset;

      @media (width > 47.5rem) {
        margin-inline: auto;
      }
    }

    p {
      max-width: 65ch;

      @media (width > 47.5rem) {
        margin-inline: auto;
      }
    }

    .details__info-container {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1rem;
      row-gap: 2rem;
      max-width: 1100px;
      margin-bottom: 3rem;
      margin-inline: auto;
      padding: 1em;
      background-color: #c6e1fc28;
      border-radius: 4px;

      @media (width > 47.5rem) {
        grid-template-columns: repeat(3, 1fr);
        margin-bottom: 4rem;
        padding: 1em 2em;
      }

      .details__info-block {
        @media (width > 47.5rem) {
          margin-left: 30%;
        }

        span {
          color: #44474a;
        }

        .cmp-body-text {
          font-size: clamp(var(--fs-14), 0.7vw + 0.4rem, var(--fs-16));
          font-weight: var(--fw-semibold);
          margin-top: 0.25rem;
          margin-bottom: 0.5rem;
          line-height: var(--lh-155);
        }
      }
    }

    .details__cards-container {
      .cmp-small-heading {
        font-size: clamp(var(--fs-18), 1vw + 0.6rem, var(--fs-22));
        margin-bottom: 3rem;
      }

      .details__cards-inner-container {
        display: grid;
        grid-template-columns: 1fr;
        gap: 2.5rem;
        place-content: center;

        @media (width > 42rem) {
          grid-template-columns: 1fr 1fr;
        }

        @media (width > 62.5rem) {
          grid-template-columns: 1fr 1fr 1fr;
        }

        .details-card {
          display: flex;
          gap: 1rem;
          max-width: 25rem;
          margin-inline: auto;
          padding: 1.5rem 1.5rem 2rem 1.5rem;
          border-radius: 8px;
          border: 2px solid #edeeef;
          box-shadow: var(--box-shadow-20);
          transition: translate 0.2s ease-out;

          &:hover {
            translate: 0 -0.15rem;
          }

          h3 {
            font-size: clamp(var(--fs-16), 2vw + 0.25rem, var(--fs-18));
          }

          p {
            margin-top: 0.5rem;
          }

          svg {
            align-self: center;
            padding: 0.6rem;
            background: #e7e8e9d8;
            border-radius: 4px;
            max-width: 2.5rem;
            min-width: 2.25rem;
          }
        }
      }
    }
  }

  .rental-aside-container {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding: 2em;
    max-width: 1200px;
    margin-inline: auto;
    background: #e7e8e9;
    border-radius: 16px;

    @media (width > 42rem) {
      flex-direction: row;
      gap: 4rem;
      padding: 3em;
    }

    svg {
      max-width: 1rem;
      min-width: 1rem;
      margin-left: 0.5rem;
      margin-right: 0.5rem;
    }

    .rental-aside-text {
      max-width: 55ch;

      h2 {
        text-wrap: pretty;
      }
    }

    .rental-aside-btn {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.5rem;
      margin-top: 0.75rem;

      a {
        display: flex;
        padding: 1.5em 2em;
        white-space: nowrap;
      }

      span {
        font-size: var(--fs-13);
        color: #44474a;
      }
    }
  }

  .map-container {
    svg {
      max-width: 1.25rem;
      min-width: 1.25rem;
      margin-left: 0.5rem;
    }

    p {
      max-width: 65ch;
    }

    .map__inner-container {
      display: grid;
      width: 100%;

      @media (width > 62.5rem) {
        width: 70%;
      }

      > * {
        grid-area: 1 / 1;
      }
    }

    .map-image {
      margin-top: 4rem;
      border-radius: 8px;
    }

    .map-text {
      display: flex;
      justify-content: space-between;
      align-items: center;
      align-self: end;
      max-width: 805px;
      padding: 0.25em 0.5em;
      margin: 1rem;
      background-color: var(--clr-white-10);
      border-radius: 4px;
      box-shadow: var(--box-shadow-30);
      z-index: 10;

      @media (width > 30rem) {
        padding: 1em 0.75em;
        gap: 2rem;
      }

      .map-text__text {
        display: flex;
        gap: 0.5rem;
      }

      span {
        display: block;
      }

      & span:last-of-type {
        font-size: var(--fs-13);
        font-weight: var(--fw-regular);
        color: #44474ad1;
      }

      .map-btn {
        display: flex;

        a {
          display: none;
          font-size: var(--fs-13);
          font-weight: var(--fw-semibold);
          color: var(--clr-brown-10);
          letter-spacing: 0.65px;
          transition: opacity 0.2s ease-out;

          @media (width > 30rem) {
            display: unset;
          }

          &:hover {
            opacity: 0.65;
          }
        }
      }
    }
  }
</style>

<script>
  import GLightbox from "glightbox";

  let lightbox;

  document.addEventListener("astro:page-load", () => {
    lightbox?.destroy();

    if (!document.querySelector(".glightbox")) return;

    lightbox = GLightbox({
      selector: ".glightbox",
      touchNavigation: true,
      keyboardNavigation: true,
      loop: false,
      zoomable: true,
    });
  });
</script>
