---
import BaseLayout from "@layouts/BaseLayout.astro";
import { Image, getImage } from "astro:assets";
import apartOne from "@assets/images/apart-one.webp";
import apartTwo from "@assets/images/apart-two.webp";
import apartThree from "@assets/images/apart-three.webp";
import apartFour from "@assets/images/apart-four.webp";
import apartFive from "@assets/images/apart-five.webp";
import apartSix from "@assets/images/apart-six.webp";
import rentalMap from "@assets/images/rental-map.png";
import "glightbox/dist/css/glightbox.css";

const apartmentImages = [apartTwo, apartOne, apartThree, apartFour, apartFive, apartSix];

const lightboxImages = await Promise.all(
  apartmentImages.map((image) =>
    getImage({
      src: image,
      width: Math.min(image.width, 2000),
      format: "webp",
      quality: 85,
    }),
  ),
);

const pageTitle = "Alojemento | Luis Ferreira Transferências e Serviços";
const pageDescription =
  "Descubra alojamento de férias no Algarve, disponibilizado diretamente pelo proprietário para uma experiência de reserva simples e personalizada.";
---

<BaseLayout pageTitle={pageTitle} pageDescription={pageDescription} bodyClass="secondary-page">
  <section class="cmp-hero-section" aria-labelledby="hero-section">
    <div class="wrapper">
      <div class="hero-container">
        <div class="hero__text-container">
          <div>
            <span class="cmp-topper-heading">CARVOEIRO, ALGARVE &nbsp;&nbsp;•&nbsp;&nbsp; BEM NA PRAIA</span>
            <h1 id="hero-section" class="cmp-hero-heading">
              Apartamento de Férias em Carvoeiro
            </h1>
          </div>

          <div>
            <p class="cmp-main-text">
              O seu refúgio à beira-mar no coração do Algarve. Desfrute de espaços luminosos, tranquilidade e conforto
              moderno, praticamente em cima da praia e a poucos instantes do centro histórico de Carvoeiro. Disponível
              por apenas
              <strong>&nbsp;€350 por semana&nbsp;</strong>
              até ao final de março.
            </p>
          </div>
        </div>

        <div class="hero__btn-container">
          <a href="" class="cmp-main-btn">
            <svg viewBox="0 0 15 15">
              <path
                d="M3 9H9V7.5H3V9V9M3 6.75H12V5.25H3V6.75V6.75M3 4.5H12V3H3V4.5V4.5M0 15V1.5C0 1.0875 0.146875 0.734375 0.440625 0.440625C0.734375 0.146875 1.0875 0 1.5 0H13.5C13.9125 0 14.2656 0.146875 14.5594 0.440625C14.8531 0.734375 15 1.0875 15 1.5V10.5C15 10.9125 14.8531 11.2656 14.5594 11.5594C14.2656 11.8531 13.9125 12 13.5 12H3L0 15V15M2.3625 10.5H13.5V10.5V10.5V1.5V1.5V1.5H1.5V1.5V1.5V11.3438L2.3625 10.5V10.5M1.5 10.5V10.5V1.5V1.5V1.5V1.5V1.5V1.5V10.5V10.5V10.5V10.5V10.5"
                fill="#25d366"
              />
            </svg>
            WHATSAPP DIRETO
          </a>

          <a href="" class="cmp-main-btn">
            <svg viewBox="0 0 12 12">
              <path d="M1.05 11.25L0 10.2L8.7 1.5H3.75V0H11.25V7.5H9.75V2.55L1.05 11.25V11.25" fill="black" />
            </svg>
            RESERVAR NO AIRBNB
          </a>
        </div>
      </div>

      <div>
        <span class="cmp-topper-heading image-span">Clique na foto para ver mais</span>

        <div class="hero-image-container">
          {apartmentImages.map((image, index) => (
            <a
              class:list={["hero-image", "glightbox", { "desktop-only": index > 0 && index < 4 }]}
              href={lightboxImages[index].src}
              data-gallery="apartment-gallery"
              aria-label={`View apartment image ${index + 1}`}
            >
              {(index === 0 || index < 4) && (
                <Image src={image} alt="Fotos do imóvel para arrendamento" format="webp" layout="constrained" />
              )}
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="cmp-main-section" aria-labelledby="details-section">
    <div class="wrapper" data-animate="fade-in">
      <div class="details-container">
        <div>
          <div class="details__header-container">
            <span class="cmp-topper-heading">ALOJAMENTO EXCLUSIVO • CARVOEIRO</span>
            <h2 id="details-section" class="cmp-main-heading">
              A tranquilidade do mar aliada à comodidade da vila
            </h2>

            <p class="cmp-body-text">
              Cuidadosamente mobilado e decorado segundo a arquitetura costeira algarvia, este apartamento oferece o
              equilíbrio perfeito entre sofisticação descontraída e hospitalidade calorosa, complementado por um
              espaçoso terraço virado a sul.
            </p>

            <br />

            <p class="cmp-body-text">
              A curta distância a pé de padarias locais, restaurantes de peixe fresco e da icónica praia de Carvoeiro,
              poderá usufruir das suas férias com total autonomia e sem necessidade diária de viatura.
            </p>
          </div>

          <div class="details__info-container">
            <div class="details__info-block">
              <span class="cmp-topper-heading">TIPOLOGIA</span>
              <p class="cmp-body-text">T2 (2 Quartos)</p>
              <p class="cmp-body-mini-text">4 Individuais</p>
            </div>

            <div class="details__info-block">
              <span class="cmp-topper-heading">LOTAÇÃO MÁXIMA</span>
              <p class="cmp-body-text">4 Hóspedes</p>
              <p class="cmp-body-mini-text">Ideal para famílias ou amigos</p>
            </div>

            <div class="details__info-block">
              <span class="cmp-topper-heading">CASAS DE BANHO</span>
              <p class="cmp-body-text">1 Casa de Banho</p>
              <p class="cmp-body-mini-text">Banheira/ Chuveiro</p>
            </div>

            <div class="details__info-block">
              <span class="cmp-topper-heading">ESPAÇO EXTERIOR</span>
              <p class="cmp-body-text">Terraço Privado</p>
              <p class="cmp-body-mini-text">Bem na praia</p>
            </div>

            <div class="details__info-block">
              <span class="cmp-topper-heading">ESTACIONAMENTO</span>
              <p class="cmp-body-text">Privativo / Fácil</p>
              <p class="cmp-body-mini-text">Junto ao edifício</p>
            </div>

            <div class="details__info-block">
              <span class="cmp-topper-heading">PROTOCOLO HIGIENE</span>
              <p class="cmp-body-text">Limpeza Profissional</p>
              <p class="cmp-body-mini-text">Limpeza semanal profissional</p>
            </div>
          </div>
        </div>

        <div class="details__cards-container">
          <h3 class="cmp-small-heading">Comodidades & Conforto Moderno</h3>

          <div class="details__cards-inner-container">
            <div class="details-card">
              <svg viewBox="0 0 17 19">
                <path
