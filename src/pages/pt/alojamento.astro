                  fill="#7A582F"
                />
              </svg>

              <div>
                <h3>Varanda à Beira-Mar</h3>
                <p class="cmp-body-mini-text">
                  Desfrute de pequenos-almoços e jantares ao ar livre na varanda, praticamente sobre a praia, com uma
                  vista deslumbrante sobre o mar.
                </p>
              </div>
            </div>

            <div class="details-card">
              <svg viewBox="0 0 15 19">
                <path
                  d="M3.66667 5.5V2.75H5.5V5.5H3.66667V5.5M3.66667 13.75V9.16667H5.5V13.75H3.66667V13.75M1.83333 18.3333C1.32917 18.3333 0.897569 18.1538 0.538542 17.7948C0.179514 17.4358 0 17.0042 0 16.5V1.83333C0 1.32917 0.179514 0.897569 0.538542 0.538542C0.897569 0.179514 1.32917 0 1.83333 0H12.8333C13.3375 0 13.7691 0.179514 14.1281 0.538542C14.4872 0.897569 14.6667 1.32917 14.6667 1.83333V16.5C14.6667 17.0042 14.4872 17.4358 14.1281 17.7948C13.7691 18.1538 13.3375 18.3333 12.8333 18.3333H1.83333V18.3333M1.83333 16.5H12.8333V16.5V16.5V8.25H1.83333V16.5V16.5V16.5V16.5M1.83333 6.41667H12.8333V1.83333V1.83333V1.83333H1.83333V1.83333V1.83333V6.41667V6.41667"
                  fill="#7A582F"
                />
              </svg>

              <div>
                <h3>Cozinha 100% Equipada</h3>
                <p class="cmp-body-mini-text">
                  Frigorífico, micro-ondas, máquina de lavar roupa, placa elétrica de 4 discos, máquina de café Delta,
                  chaleira e torradeira.
                </p>
              </div>
            </div>

            <div class="details-card">
              <svg viewBox="0 0 22 16">
                <path
